generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String       @id @default(uuid()) @db.Uuid
  googleId              String?      @unique
  appleSub              String?      @unique
  /// Hasz tożsamości zakupowej: HMAC-SHA256 z `authProvider:sub` i pieprzu
  /// serwera (`PURCHASE_IDENTITY_PEPPER`). Wyliczany przy logowaniu.
  ///
  /// PO CO OSOBNA KOLUMNA, SKORO JEST `appleSub`. Ten hasz jest jedynym
  /// śladem, który MA przeżyć skasowanie konta: pula próbna i subskrypcja
  /// wiszą na nim, a nie na `User.id`, więc „usuń konto → zarejestruj się
  /// znowu" nie daje ani nowej próby, ani utraty opłaconego PRO. Hasz, a nie
  /// czysty `sub`, bo wyciek bazy nie ma prawa wydać identyfikatorów Apple
  /// osób, które już u nas nie mają konta.
  identityHash          String?
  authProvider          AuthProvider @default(GOOGLE)
  displayName           String
  email                 String?
  emailVerified         Boolean      @default(false)
  avatarUrl             String?
  yearOfBirth           Int?
  heightCm              Int?
  // Waga jako Float, nie Int — wagi ciała podaje się z dokładnością do
  // 0,1 kg i zaokrąglanie 83,5 do 84 psuło zarówno BMI, jak i policzone
  // zapotrzebowanie.
  weightKg              Float?
  // Płeć wchodzi wyłącznie do wzoru Mifflina-St Jeora, który różnicuje BMR
  // stałą (+5 / −161). Nullable, bo konta założone wcześniej jej nie mają
  // i wtedy klient liczy ze średniej.
  sex                   Sex?
  // Indeks gradientu awatara, przydzielany raz przy kończeniu onboardingu.
  // Trzymany na serwerze, a nie liczony z hasza na kliencie, bo przydział
  // musi widzieć, jakie kolory zajęli już pozostali domownicy — inaczej
  // dwie osoby w jednym gospodarstwie potrafiłyby wylosować to samo.
  avatarColor           Int?
  onboardingCompletedAt DateTime?
  lastLoginAt           DateTime?
  /// Wersja tokenów dostępu. Podbicie unieważnia WSZYSTKIE wydane JWT tej
  /// osoby (wykrycie ponownego użycia refresh tokenu, wylogowanie zewsząd) —
  /// bez tego skradziony token dostępu żył do końca swojego TTL.
  tokenVersion          Int          @default(0)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  recipes         Recipe[]
  subscriptions   Subscription[]  @relation("SubscriptionPurchaser")
  memberships     Membership[]
  createdHomes    Household[]     @relation("HouseholdCreator")
  invitations     Invitation[]    @relation("InvitationCreator")
  acceptedInvites Invitation[]    @relation("InvitationRedeemer")
  /// Zaproszenia leżące w skrzynce tego użytkownika — patrz
  /// `Invitation.invitedUserId`.
  receivedInvites Invitation[]    @relation("InvitationRecipient")
  refreshTokens   RefreshToken[]
  pushDevices     PushDevice[]
  preferences     UserPreference?

  planParticipations PlanItemParticipant[]
  mealConsumptions   PlanItemConsumption[]

  cookidooIntegrations CookidooIntegration[] @relation("CookidooIntegrationConnector")

  dailySteps DailyStepCount[]

  agentConversations AgentConversation[]
  consentEvents      ConsentEvent[]
  agentReports       AgentReport[]
  /// Maile zakolejkowane do tej osoby. `SetNull`, nie kaskada — patrz
  /// `MailMessage.userId`: mail pożegnalny musi przeżyć skasowanie konta.
  mailMessages       MailMessage[]

  @@index([identityHash])
}

/// Zgłoszenie niewłaściwej odpowiedzi asystenta („Zgłoś odpowiedź").
///
/// App Store 1.2 / 4.7: treści generowane muszą mieć mechanizm zgłaszania.
/// Bez kluczy obcych do wiadomości i rozmowy — retencja 90 dni kasuje
/// rozmowy, a zgłoszenie ma przeżyć razem z MIGAWKĄ treści (`messageText`),
/// bo bez niej nie da się go rozpatrzyć. Kaskada tylko z kontem.
model AgentReport {
  /// `dbgenerated`, nie `uuid()`: migracja tej tabeli była pisana ręcznie
  /// z `DEFAULT gen_random_uuid()` i tak stoi na produkcji. Schema musi mówić
  /// to samo, co baza — inaczej `migrate dev` widzi rozjazd i żąda resetu.
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @db.Uuid
  conversationId String?  @db.Uuid
  messageId      String?  @db.Uuid
  turnId         String?  @db.Uuid
  reason         String
  comment        String?
  messageText    String
  createdAt      DateTime @default(now())
  /// Decyzja z panelu administratora (ROADMAPA §5.5): NEW | REVIEWED |
  /// DISMISSED. Tekst, nie enum — ta sama defensywna konwencja migracji co
  /// przy `CookidooIntegration.status`; wartości pilnuje panel.
  status            String    @default("NEW")
  reviewedAt        DateTime?
  /// `AdminUser.id` — celowo BEZ klucza obcego: tabele aplikacji nie wiedzą
  /// nic o panelu, a zgłoszenie ma przeżyć także zmianę konta admina.
  reviewedByAdminId String?   @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([status, createdAt])
}

/// Zdarzenia zgód — TYLKO dopisywanie, nigdy nadpisywanie.
///
/// Art. 7 ust. 1 RODO: administrator musi umieć wykazać, że zgoda była, kiedy
/// i na jaką treść. Jeden wiersz per kliknięcie: `kind` (TERMS | PRIVACY |
/// AI_ASSISTANT | COOKIDOO | AGE_16), `action` (GRANTED | REVOKED),
/// `documentVersion` = data wersji dokumentu z `src/common/legal-documents.ts`
/// (stała w kodzie, nie zmienna na Railway — literówka w env unieważniałaby
/// zgody wszystkim naraz). „Zgoda ważna" = ostatnie zdarzenie dla pary
/// (użytkownik, rodzaj) to GRANTED i jego wersja nie jest starsza niż
/// minimalna wymagana.
///
/// Zgoda na asystenta jest PER OSOBA i globalna dla konta (nie per dom): to
/// zgoda na wysyłanie danych TEJ osoby do modelu, a te są te same w każdym
/// gospodarstwie. `householdId` jest wyłącznie kontekstem dowodowym.
/// Kaskada z kontem: po usunięciu konta nie ma już komu przypisać dowodu.
model ConsentEvent {
  /// `dbgenerated`, nie `uuid()`: migracja tej tabeli była pisana ręcznie
  /// z `DEFAULT gen_random_uuid()` i tak stoi na produkcji. Schema musi mówić
  /// to samo, co baza — inaczej `migrate dev` widzi rozjazd i żąda resetu.
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @db.Uuid
  kind            String
  action          String
  documentVersion String
  source          String?
  appVersion      String?
  householdId     String?  @db.Uuid
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
}

model UserPreference {
  userId         String              @id @db.Uuid
  dietPreference DietPreferenceValue @default(NONE)
  calorieGoal    Int                 @default(2000)
  allergens      String[]            @default([])
  goal           UserGoal            @default(HEALTHY)
  activityLevel  Int                 @default(2)
  // Makra w gramach. Nullable, bo dopóki uzytkownik ich nie tknie, klient
  // liczy je z celu, sylwetki i liczby treningow — a policzona wartosc ma
  // podazac za zmianami tamtych, nie zamrazac sie w bazie. Zapisujemy je
  // dopiero, gdy ktos je nadpisze recznie.
  proteinG       Int?
  fatG           Int?
  carbsG         Int?

  /// Czego ten domownik NIE JE, choć nie jest to alergia.
  ///
  /// Alergeny są twarde i wynikają ze składu; to jest zwykła niechęć
  /// („bez pieczarek"). Do Fazy 1 taka informacja żyła wyłącznie w rozmowie
  /// z asystentem i ginęła razem z nią — model pamiętał ją do końca tury,
  /// a przy następnym pytaniu proponował pieczarki od nowa. Trzymamy
  /// identyfikatory, nie nazwy: model rozwiązuje nazwę przez
  /// `search_ingredients`, a walidator planu porównuje id ze składem przepisu.
  excludedIngredientIds String[] @default([])

  /// Ile minut najwyżej ma zajmować gotowanie w dzień powszedni.
  ///
  /// To PODPOWIEDŹ, nie bramka: niedzielna pieczeń ma prawo trwać dłużej,
  /// a twarde odrzucanie wszystkiego powyżej progu zamieniłoby preferencję
  /// w karę. Trafia do kontekstu modelu, nie do `collectPlanViolations`.
  maxPrepTimeMinutes Int?

  /// Kanały powiadomień push. Do tej pory przełączniki z Ustawień żyły
  /// wyłącznie w `UserDefaults` na telefonie, więc wyciszenie powiadomień
  /// uciszało tylko lokalne bannery, a pushe z serwera leciały dalej —
  /// z perspektywy użytkownika główny przełącznik był popsuty. Serwer musi
  /// znać te wartości, bo to on decyduje, czy w ogóle wysłać.
  pushPlanChanges  Boolean @default(true)
  pushShoppingList Boolean @default(true)
  pushHousehold    Boolean @default(true)

  /// Cisza nocna. Zbiorcze podsumowania (plan, lista zakupów) nie wychodzą
  /// między 22:00 a 7:00 czasu użytkownika — czekają na koniec okna. Dołączenie
  /// domownika jej nie podlega: to zdarzenie jednorazowe, na które ktoś czeka.
  pushQuietHours Boolean @default(true)

  /// Strefa czasowa IANA z telefonu (`TimeZone.current.identifier`). Bez niej
  /// cisza nocna liczyłaby się w strefie kontenera, czyli zwykle w UTC —
  /// a to przesuwa okno o dwie godziny w polskim lecie.
  timeZone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  /// Dlaczego token przestał być ważny: ROTATED | LOGOUT | REUSE | RECOVERED.
  /// Bez tego każde ponowne użycie wygląda tak samo, a to dwie różne
  /// sytuacje: klient, ktory zgubil odpowiedz z rotacji, i cudza kopia
  /// starego tokenu.
  revokedReason String?
  /// Hash nastepcy wydanego przy rotacji tego tokenu. Pozwala rozpoznac
  /// telefon, do ktorego nowa para nigdy nie dojechala (iOS uspil proces
  /// w polowie zadania), i oddac mu swieza pare zamiast kasowac cala
  /// rodzine tokenow.
  replacedByHash String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([replacedByHash])
}

model Recipe {
  id                    String     @id @default(uuid()) @db.Uuid
  title                 String
  description           String?
  sourceProvider        String?
  sourceRecipeId        String?
  sourceCategory        String?
  sourceCuisine         String?
  sourceTags            String[]   @default([])
  sourceMeta            Json?
  sourceDietary         Json?
  sourceStorage         Json?
  sourceEquipment       Json?
  sourceInstructions    Json?
  sourceTroubleshooting Json?
  sourceChefNotes       Json?
  sourceCulturalContext String?
  sourceNutrition       Json?
  sourceRaw             Json?
  /// Slot, do którego przepis należy „z natury" — steruje sekcją na
  /// Przepisach, okładką i akcentem. Zawsze dokładnie jeden.
  mealType              MealType
  /// Wszystkie sloty, w których danie ma sens. Zawiera `mealType` plus te
  /// dołożone ręcznie albo przez klasyfikator (`suitable-meal-types.util`).
  /// To ono, a nie `mealType`, decyduje o tym, co widać przy dodawaniu
  /// posiłku do slotu — dzięki temu jedna owsianka wpada i na śniadanie,
  /// i na II śniadanie, bez duplikowania przepisu.
  /// Puste = brak backfillu; czytający traktują to jak `[mealType]`.
  suitableMealTypes     MealType[] @default([])
  difficulty            Difficulty @default(EASY)
  prepTimeMinutes       Int        @default(0)
  servings              Int        @default(1)
  imageUrl              String?
  nutritionKcal         Float      @default(0)
  nutritionProtein      Float      @default(0)
  nutritionFat          Float      @default(0)
  nutritionCarbs        Float      @default(0)
  nutritionFiber        Float      @default(0)
  /// Sól ŁĄCZNIE (g na przepis): ze składników (sód × 2,5) + dodana.
  nutritionSalt         Float      @default(0)
  /// Sól DODANA ręcznie (g na przepis) — jedyna część, której nie da się
  /// policzyć ze składników; recompute liczy resztę i sumuje.
  nutritionSaltAdded    Float      @default(0)
  isActive              Boolean    @default(true)
  /// Czy przepis należy do WSPÓLNEGO katalogu (widoczny dla wszystkich
  /// gospodarstw), czy jest prywatnym przepisem swojego gospodarstwa.
  ///
  /// Do tej pory widoczności nie było wcale — `findAll` czytał bez
  /// `householdId`, a katalog rozpoznawało się po magicznym id gospodarstwa.
  /// Dopóki pisał tylko bot importu, nikt tego nie zauważył; z chwilą, gdy
  /// pisać zacznie asystent, przepis utworzony dla jednego domu trafiłby na
  /// listę wszystkich pozostałych.
  isCatalog             Boolean    @default(false)
  /// Unia alergenów składników (id jak w `UserPreference.allergens`,
  /// `src/common/allergens.ts`) — liczona przy imporcie, `recipes:create`
  /// i przez `scripts/load-ingredient-tags.ts`. Puste ≠ „brak danych":
  /// przepis bez składników rozpoznaje się po `ingredients`, nie po tagach.
  allergens             String[]   @default([])
  /// Unia tagów dietetycznych składników (`src/common/diet-tags.ts`:
  /// MEAT, FISH, DAIRY, EGG, GLUTEN_GRAIN, GRAIN, LEGUME, PROCESSED…).
  dietTags              String[]   @default([])
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  authorId    String    @db.Uuid
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  householdId String    @db.Uuid
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  planItems   PlanItem[]
  ingredients RecipeIngredient[]
  /// Składniki dopisane z tego przepisu do list zakupów („brakuje mi").
  shoppingListExtras ShoppingListExtra[]
  favorites   RecipeFavorite[]

  // Druga gałąź filtru widoczności (`isCatalog = true OR householdId = …`).
  // Sam `isCatalog` indeksu nie dostaje — jest niskoselektywny.
  @@index([householdId])
  // GIN — zapytania po slocie idą teraz przez `suitableMealTypes has X`,
  // a B-tree nie obsłuży zawierania w tablicy.
  @@index([suitableMealTypes], type: Gin)
  // „Bez alergenu X" / „bez tagu Y" to też zawieranie w tablicy.
  @@index([allergens], type: Gin)
  @@index([dietTags], type: Gin)
}

model Ingredient {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @unique
  normalizedName String   @unique
  category       String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Wartosci odzywcze na 100 g (jednostka `g`) lub 100 ml (jednostka `ml`),
  // stan surowy. `nutritionCarbsPer100` to weglowodany przyswajalne, bez
  // blonnika. Nullable: nowy skladnik bez makro ma sie dodac, audyt zglosi
  // go jako luke. Zrodlo: prisma/catalog/ingredient-nutrition-pl-v1.json
  nutritionKcalPer100     Float?
  nutritionProteinPer100  Float?
  nutritionCarbsPer100    Float?
  nutritionFatPer100      Float?
  nutritionFiberPer100    Float?
  /// Sód w mg na 100 g/ml (IZZ/USDA). Sól przepisu = sód ze składników × 2,5
  /// + sól dodana — dotąd „sól" znaczyła dwie różne rzeczy w dwóch partiach.
  nutritionSodiumMgPer100 Float?

  /// Masa jadalnej czesci 1 sztuki — dla skladnikow mierzonych w `szt`.
  gramsPerPiece Float?

  /// Skad pochodza powyzsze wartosci, np. "ingredient-nutrition-pl-v1".
  nutritionSource String?

  /// Alergeny składnika — id z `src/common/allergens.ts` (te same, których
  /// używa `UserPreference.allergens`). Źródło: kuratorowany plik
  /// prisma/catalog/ingredient-tags-pl-v1.json (`pnpm catalog:ingredients:tags`).
  allergens String[] @default([])
  /// Tagi dietetyczne składnika — `src/common/diet-tags.ts`.
  dietTags  String[] @default([])

  aliases           IngredientAlias[]
  recipeIngredients RecipeIngredient[]
}

model IngredientAlias {
  id              String   @id @default(uuid()) @db.Uuid
  ingredientId    String   @db.Uuid
  alias           String   @unique
  normalizedAlias String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([ingredientId])
}

model Household {
  id               String     @id @default(uuid()) @db.Uuid
  name             String
  /// Sloty posiłków, które gospodarstwo planuje. Trzymane per gospodarstwo,
  /// a nie per użytkownik, bo plan tygodnia i lista zakupów są wspólne —
  /// gdyby Ania miała podwieczorek, a Marek nie, jedno z nich widziałoby
  /// plan z dziurą i listę zakupów, która się z nim nie zgadza.
  /// Trójka BREAKFAST/LUNCH/DINNER jest obowiązkowa i walidowana w serwisie.
  enabledMealTypes MealType[] @default([BREAKFAST, LUNCH, DINNER])
  /// Pory posiłków: mapa slot → minuty od północy, np. `{"BREAKFAST": 480}`.
  /// Minuty, nie `DateTime`, bo pora posiłku to punkt w dobie — `DateTime`
  /// wciągnąłby tu datę i strefę czasową, których ta wartość nie ma.
  /// `null` = gospodarstwo nie ruszało godzin (klient bierze swoje domyślne).
  /// Brak klucza = ten posiłek nie ma stałej pory (tak działa przekąska),
  /// więc pusta mapa i `null` znaczą co innego.
  mealSlotTimes    Json?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  createdById      String?    @db.Uuid
  createdBy        User?      @relation("HouseholdCreator", fields: [createdById], references: [id], onDelete: SetNull)

  memberships               Membership[]
  recipes                   Recipe[]
  invitations               Invitation[]
  weeklyPlans               WeeklyPlan[]
  shoppingLists             ShoppingList[]
  shoppingItemChecks        ShoppingItemCheck[]
  shoppingListArchives      ShoppingListArchive[]
  shoppingListArchiveStates ShoppingListArchiveState[]
  shoppingListExtras        ShoppingListExtra[]
  recipeFavorites           RecipeFavorite[]
  cookidooIntegration       CookidooIntegration?
  agentConversations        AgentConversation[]
  agentMemories             AgentMemory[]
  /// Ręczne nadanie planu (operator, `POST /ops/households/:id/tier`):
  /// rodzina testująca, rekompensata, konto recenzenta App Store. Ma
  /// pierwszeństwo przed subskrypcją; `null` = liczy się subskrypcja.
  tierOverride              HouseholdTier?
}

/// Plan gospodarstwa: TRIAL = jednorazowa pula na próbę (bez odnowienia),
/// PRO = pula miesięczna. Liczony przy każdym żądaniu z nadania operatora,
/// subskrypcji i `AI_TIER_OVERRIDE` — nie jest nigdzie „zapisany na stałe".
enum HouseholdTier {
  TRIAL
  PRO
}

enum SubscriptionProvider {
  APPLE
  MANUAL
}

enum SubscriptionStatus {
  ACTIVE
  /// Płatność nie przeszła, Apple daje czas na jej poprawienie — PRO zostaje.
  GRACE
  EXPIRED
  REVOKED
}

/// Subskrypcja PRO — należy do OSOBY, która ją kupiła, nigdy do domu.
///
/// DLACZEGO NIE `householdId`. Poprzednia wersja trzymała subskrypcję jako
/// wiersz przypięty do gospodarstwa (`HouseholdSubscription`, klucz główny =
/// `householdId`, kaskada od domu). Cztery niezależne testy obalające pokazały
/// tę samą dziurę: przypisanie było ZAPISYWANE, a zdarzeń, które je psują
/// (wyjście z domu, usunięcie członka, skasowanie konta, sprzątnięcie pustego
/// domu, przyjęcie zaproszenia), jest więcej niż miejsc, które je naprawiają.
/// Wynik: człowiek płaci Apple i siedzi bez asystenta, bez żadnego przycisku,
/// który by to odkręcił. Drugi wynik: „wyjdź z domu → załóż nowy" dawało
/// świeżą pulę wiadomości przy jednej opłacie.
///
/// Teraz przypisania NIE MA. Uprawnienie domu wylicza się przy każdym żądaniu
/// z faktu „czy któryś z obecnych domowników ma żywą subskrypcję"
/// (`AiUsageCountersService.resolvePlan`). Nie ma czego przypiąć, więc nie ma
/// czego zgubić — a pula liczy się w zakresie `sub:<id>`, czyli wędruje razem
/// z umową i nie odnawia się od przeprowadzki.
///
/// `purchaserUserId` jest wyłącznie wskaźnikiem na konto (SetNull): tożsamość
/// płatnika niesie `identityHash`, który przeżywa skasowanie konta — bo Apple
/// pobiera pieniądze niezależnie od tego, czy konto u nas istnieje.
model Subscription {
  id                    String               @id @default(uuid()) @db.Uuid
  /// Kto płaci — patrz `User.identityHash`. To jest prawdziwy właściciel.
  identityHash          String
  /// Wskaźnik na konto; `SetNull`, bo subskrypcja musi przeżyć jego usunięcie.
  purchaserUserId       String?              @db.Uuid
  purchaser             User?                @relation("SubscriptionPurchaser", fields: [purchaserUserId], references: [id], onDelete: SetNull)
  provider              SubscriptionProvider
  productId             String
  originalTransactionId String?              @unique
  latestTransactionId   String?
  status                SubscriptionStatus
  /// Koniec opłaconego okresu (z Apple, w UTC).
  expiresAt             DateTime?
  /// Koniec łaski płatniczej. Apple potrafi dać do 16 dni po `expiresAt`;
  /// bez osobnej kolumny status GRACE nigdy by nie zadziałał, bo warunek
  /// żywotności i tak odbijał się o `expiresAt` w przeszłości.
  graceExpiresAt        DateTime?
  /// Tylko nadania ręczne (MANUAL) mogą nie mieć końca. Dla APPLE brak daty
  /// znaczy „nie wiemy", czyli MARTWA — nigdy „żywa na zawsze".
  neverExpires          Boolean              @default(false)
  autoRenewStatus       Boolean?
  autoRenewProductId    String?
  /// `Sandbox` albo `Production`. Transakcja z sandboxa NIE daje PRO na
  /// produkcji — inaczej każdy z TestFlightem miałby darmowe PRO na zawsze.
  environment           String?
  /// `PURCHASED` albo `FAMILY_SHARED`. Chowanie tego pod polityką w App Store
  /// Connect nie wystarcza: jedna opłata rozdana przez Chmurę Rodzinną to do
  /// pięciu gospodarstw z pełną pulą każde.
  ownershipType         String?
  /// Zwrot pieniędzy albo cofnięcie dostępu przez Apple — PRO znika od razu.
  revokedAt             DateTime?
  /// Migawka limitów z chwili zakupu. Cennik wolno podnieść w każdej chwili,
  /// ale obniżka NIE MOŻE zejść komuś, kto już zapłacił (to zmiana warunków
  /// umowy w trakcie). Puste = limity liczone z bieżącej mapy produktów.
  messagesLimitSnapshot Int?
  plansLimitSnapshot    Int?
  lastNotificationAt    DateTime?
  lastNotificationType  String?
  /// Ostatnie uzgodnienie z App Store Server API — czym starsze, tym większa
  /// szansa, że zgubiliśmy powiadomienie.
  lastVerifiedAt        DateTime?
  /// Blokada nałożona ręcznie przez obsługę (zwrot poza Apple, nadużycie,
  /// obciążenie zwrotne). Ucina dostęp niezależnie od tego, co mówi Apple i
  /// NIGDY nie jest czyszczona przez uzgadnianie ani przez zgłoszenie z
  /// telefonu — bez tej kolumny „Przywróć zakupy" cofało decyzję obsługi
  /// jednym kliknięciem klienta. Zdejmuje ją wyłącznie operator.
  operatorHoldAt        DateTime?
  operatorHoldReason    String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([identityHash])
  @@index([purchaserUserId])
  @@index([status, expiresAt])
}

/// Powiadomienie App Store Server Notifications v2 — jeden wiersz na
/// `notificationUUID`, ŻADNEJ kaskady.
///
/// Trzy powody, dla których to jest osobna tabela bez kluczy obcych:
/// 1. Idempotencja. Apple ponawia powiadomienie do pięciu razy przez trzy
///    doby; drugie przetworzenie tego samego zdarzenia potrafiłoby wyzerować
///    pulę albo cofnąć nowszy stan.
/// 2. Odpowiadamy 200 dopiero PO trwałym zapisie. Gdyby zapis szedł w tej
///    samej transakcji co skutek zdarzenia, deploy w złej sekundzie kasowałby
///    zdarzenie na zawsze — Apple uznało je za dostarczone.
/// 3. Zdarzenie może dotyczyć subskrypcji, której u nas jeszcze (albo już)
///    nie ma. Klucz obcy odrzucałby dokładnie te przypadki, po których
///    zostaje reklamacja.
model AppleNotification {
  notificationUuid      String    @id
  notificationType      String
  subtype               String?
  originalTransactionId String?
  environment           String?
  /// Surowy, podpisany ładunek — jedyny sposób na odtworzenie zdarzenia po
  /// błędzie i jedyny dowód, co Apple naprawdę przysłało.
  signedPayload         String
  receivedAt            DateTime  @default(now())
  processedAt           DateTime?
  attempts              Int       @default(0)
  error                 String?

  @@index([processedAt, receivedAt])
  @@index([originalTransactionId])
}

/// Pamięć asystenta: krótkie notatki, które przeżywają koniec rozmowy.
///
/// Historia idzie do modelu w obrębie JEDNEJ rozmowy (`HISTORY_WINDOW`), więc
/// bez tego nowa rozmowa zaczynała od zera i użytkownik musiał co tydzień
/// powtarzać to samo („w środy jemy u teściów"). Notatki są krótkie i wchodzą
/// do promptu w bloku gospodarstwa.
///
/// Zakres to GOSPODARSTWO, nie użytkownik: plan tygodnia, lista zakupów i
/// kwota też są wspólne, a notatka „Kuba nie je ryb" jest przydatna każdemu,
/// kto układa plan. Kto ją dodał, zostaje w `createdByUserId` — do pokazania
/// na liście i do porządków. Rzeczy wrażliwych (waga, zdrowie, cele) NIE
/// zapisujemy tutaj: te dane mają swoje miejsce w preferencjach domownika
/// i nie mają prawa wyciec do wspólnej pamięci.
model AgentMemory {
  id              String   @id @default(uuid()) @db.Uuid
  householdId     String   @db.Uuid
  /// Jedno zdanie, tak jak powiedziałby to człowiek.
  text            String
  /// `text` sprowadzony do małych liter ze sklejonymi białymi znakami.
  ///
  /// Osobna kolumna z UNIKATEM, a nie porównanie „bez rozróżniania wielkości
  /// liter" w zapytaniu: Prisma kompiluje `equals` + `mode: 'insensitive'` do
  /// `ILIKE`, więc `%` i `_` w treści notatki stawały się wieloznacznikami —
  /// „Kuba je 100% mięsa" pasowało do „Kuba je 100 dag mięsa" i nowa notatka
  /// po cichu nie powstawała. Unikat w bazie zamyka przy okazji wyścig
  /// check-then-act.
  textNormalized  String
  createdByUserId String?  @db.Uuid
  /// KOGO dotyczy notatka; `null` = całego domu.
  ///
  /// Zgoda na asystenta jest indywidualna, a notatka „Kubie nie dawać
  /// orzechów" niesie dane o zdrowiu Kuby. Do 12.09.2026 filtr porównywał
  /// IMIĘ jako podciąg tekstu, więc polska odmiana („Kubie", „u Zosi") go
  /// omijała, a notatka bez imienia („mój syn nie je ryb") była poza jego
  /// zasięgiem z definicji. Tożsamość rozstrzyga to jednoznacznie: notatka
  /// o osobie bez zgody nie powstaje, a jeśli już jest — nie idzie do modelu.
  aboutUserId     String?  @db.Uuid
  /// PREFERENCE | CONSTRAINT | HABIT — grupa na ekranie „Co o Was pamięta".
  /// Tekst, nie enum (patrz `CookidooIntegration.status`); podaje model.
  kind            String   @default("PREFERENCE")
  createdAt       DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, textNormalized])
  @@index([householdId, createdAt])
}

/// Integracja Cookidoo (Thermomix) — jedna na gospodarstwo, jak reszta
/// współdzielonej konfiguracji (plan i lista zakupów są wspólne, więc
/// „wyślij na Thermomixa" też). Poświadczenia zaszyfrowane AES-256-GCM
/// (format `v1:<iv>:<tag>:<ct>`, klucz w env COOKIDOO_ENCRYPTION_KEY) —
/// są write-only: żaden endpoint nigdy nie zwraca hasła, a odszyfrowany
/// komplet widzi wyłącznie mikroserwis Pythona przy wysyłce.
model CookidooIntegration {
  id                String    @id @default(uuid()) @db.Uuid
  householdId       String    @unique @db.Uuid
  emailEncrypted    String
  passwordEncrypted String
  /// CONNECTED | AUTH_FAILED. Tekst, nie enum — defensywna migracja enuma
  /// w Postgresie wymaga bloków DO $$, a wartości i tak waliduje serwis.
  status            String    @default("CONNECTED")
  connectedById     String?   @db.Uuid
  lastVerifiedAt    DateTime?
  lastErrorCode     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  connectedBy User?     @relation("CookidooIntegrationConnector", fields: [connectedById], references: [id], onDelete: SetNull)
}

model RecipeFavorite {
  id          String   @id @default(uuid()) @db.Uuid
  recipeId    String   @db.Uuid
  householdId String   @db.Uuid
  createdAt   DateTime @default(now())

  recipe    Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([recipeId, householdId])
  @@index([householdId])
}

model Membership {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  householdId String         @db.Uuid
  role        MembershipRole @default(MEMBER)
  createdAt   DateTime       @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
  /// Najgorętsze zapytanie w aplikacji: „kto jest w tym domu" (pokoje WS,
  /// odbiorcy powiadomień, składy). Unikat (userId, householdId) nie
  /// pomaga, bo householdId stoi w nim drugi.
  @@index([householdId])
}

model Invitation {
  id           String    @id @default(uuid()) @db.Uuid
  /// `sha256(token)` w hex — surowy token istnieje tylko w linku i w odpowiedzi
  /// na `households:createInvitation`. Zrzut bazy nie może być kompletem
  /// działających wejść do domów (ta sama zasada co `RefreshToken.tokenHash`).
  tokenHash    String    @unique
  /// WYCOFYWANE — kod tego pola nie czyta ani nie zapisuje. Zostaje na jedno
  /// wdrożenie (krok „expand"), żeby poprzednia wersja aplikacji działała
  /// w oknie deployu i po ewentualnym rollbacku; kolumnę usuwa druga migracja
  /// opisana w `docs/ZAPROSZENIA-HASZ-TOKENU.md`.
  token        String?   @unique
  householdId  String    @db.Uuid
  createdById  String?   @db.Uuid
  redeemedById String?   @db.Uuid
  expiresAt    DateTime
  redeemedAt   DateTime?
  createdAt    DateTime  @default(now())

  /// Komu to zaproszenie leży w skrzynce.
  ///
  /// Zaproszenie powstaje jako anonimowy link — właściciel wysyła go dowolnym
  /// komunikatorem i w chwili tworzenia NIE WIADOMO, kto go otworzy. Adresat
  /// zapisuje się dopiero wtedy, gdy ktoś link podejrzy
  /// (`households:previewInvitation`), i to jest jedyny moment, w którym
  /// aplikacja poznaje odbiorcę. Zapraszanie po e-mailu nie zastąpiłoby tego:
  /// przy Sign in with Apple adres bywa przekierowaniem `@privaterelay`,
  /// którego zapraszający nie zna.
  ///
  /// To pole NIE zawęża, kto może zaproszenie przyjąć — link zostaje
  /// wielorazowy do czasu wykorzystania. Służy wyłącznie do tego, żeby
  /// zaproszenie dało się później odnaleźć w aplikacji zamiast szukać
  /// w historii czatu.
  invitedUserId String? @db.Uuid
  invitedUser   User?   @relation("InvitationRecipient", fields: [invitedUserId], references: [id], onDelete: SetNull)

  /// Kiedy adresat świadomie odmówił. Odrzucone znika ze skrzynki, ale zostaje
  /// w bazie — inaczej ten sam link odłożyłby się tam z powrotem przy
  /// pierwszym podejrzeniu.
  declinedAt DateTime?

  household  Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy  User?     @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  redeemedBy User?     @relation("InvitationRedeemer", fields: [redeemedById], references: [id], onDelete: SetNull)

  @@index([invitedUserId])
}

model WeeklyPlan {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @db.Uuid
  weekStart   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items     PlanItem[]

  @@unique([householdId, weekStart])
}

model PlanItem {
  id           String    @id @default(uuid()) @db.Uuid
  weeklyPlanId String    @db.Uuid
  recipeId     String    @db.Uuid
  dayOfWeek    DayOfWeek
  mealType     MealType
  createdAt    DateTime  @default(now())

  /// Ile porcji przepisu faktycznie gotujemy w tym slocie. To liczba łączna,
  /// nie „na osobę". Lista zakupów skaluje składniki przez
  /// `plannedServings / recipe.servings`.
  ///
  /// Domyślnie tyle, ile osób je danie (pusty `participants` = całe
  /// gospodarstwo), ale użytkownik może to nadpisać stepperem w szczegółach
  /// posiłku. `@default(1)` jest tylko po to, żeby ALTER TABLE przeszedł na
  /// istniejących wierszach — prawdziwe wartości wylicza z audytorium ta sama
  /// migracja, tuż po dodaniu kolumny. Skrypt
  /// `scripts/backfill-plan-item-servings.ts` został jako narzędzie naprawcze
  /// dla baz, które przeszły migrację bez tego kroku.
  plannedServings Int @default(1)

  weeklyPlan   WeeklyPlan            @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  recipe       Recipe                @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  participants PlanItemParticipant[]
  consumptions PlanItemConsumption[]

  // A (day, mealType) slot can hold several items — one per recipe — so the
  // household can split a meal ("Ania eats a salad, Marek a schnitzel").
  // Uniqueness is recipe-aware to keep the same recipe from being added twice
  // to one slot.
  @@unique([weeklyPlanId, dayOfWeek, mealType, recipeId])
  @@index([weeklyPlanId, dayOfWeek, mealType])
  /// Wycofanie przepisu, import katalogu i „gdzie ten przepis jest w planie"
  /// szukają po przepisie — bez indeksu to pełny skan pozycji.
  @@index([recipeId])
}

/// Which household members a given plan item is for.
/// An empty participant set means "everyone" — that keeps every pre-split row
/// valid without a backfill, and is what the app renders as „Wspólne".
model PlanItemParticipant {
  planItemId String   @db.Uuid
  userId     String   @db.Uuid
  createdAt  DateTime @default(now())

  planItem PlanItem @relation(fields: [planItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([planItemId, userId])
  @@index([planItemId])
  @@index([userId])
}

/// Who actually ate a planned meal, and when.
///
/// Per-user rather than a flag on PlanItem: a shared item („Wspólne", no
/// participant rows) is eaten by each member on their own schedule, so one
/// boolean could not answer „did *I* eat this?". Row present = eaten.
model PlanItemConsumption {
  planItemId String   @db.Uuid
  userId     String   @db.Uuid
  eatenAt    DateTime @default(now())

  planItem PlanItem @relation(fields: [planItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([planItemId, userId])
  @@index([planItemId])
  @@index([userId])
}

/// Dzienna suma kroków użytkownika, synchronizowana z Apple Health (HealthKit)
/// przez telefon — także dla Garmina, bo Garmin Connect dopisuje kroki do
/// Zdrowia, a my czytamy je stamtąd. Wiersz na (użytkownik, dzień); telefon
/// nadpisuje kroczące okno ostatnich ~7 dni, bo źródła potrafią dopisywać
/// próbki z opóźnieniem. `date` to czysta data liczona w strefie telefonu —
/// serwer (UTC) nie wolno mu jej reinterpretować, jak przy `send-to-week`.
model DailyStepCount {
  userId    String   @db.Uuid
  date      DateTime @db.Date
  steps     Int
  /// Zrzut celu kroków obowiązującego danego dnia — przyszłe statystyki muszą
  /// wiedzieć, do czego użytkownik wtedy dążył, a bieżący cel trzyma telefon
  /// i może go zmienić w każdej chwili.
  stepsGoal Int
  /// APPLE_HEALTH | GARMIN — wybrane w aplikacji źródło odczytu. Tekst, nie
  /// enum — defensywna migracja enuma wymaga bloków DO $$, a wartości i tak
  /// waliduje DTO (patrz `CookidooIntegration.status`).
  source    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, date])
}

/// Rozmowa z asystentem AI — per użytkownik, w zakresie gospodarstwa
/// (limity liczą się per dom, ale historia jest osobista). Kasowana z kontem
/// (RODO) i z gospodarstwem. Status OPEN | CLOSED — tekst, nie enum (patrz
/// `CookidooIntegration.status`).
model AgentConversation {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  householdId   String    @db.Uuid
  status        String    @default("OPEN")
  title         String?
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  messages  AgentMessage[]
  turns     AgentTurn[]
  proposals AgentProposal[]

  @@index([userId, lastMessageAt])
  @@index([householdId])
}

/// Wiadomość w rozmowie. `role` USER | ASSISTANT.
///
/// `kind` mówi, CZYM jest ta wiadomość, a `card` niesie jej treść
/// strukturalną: TEXT (sam `text`, `card` puste), PLAN_WEEK (propozycja
/// tygodnia do zatwierdzenia), APPLIED (potwierdzenie zapisu). Kolejne
/// rodzaje z makiety — PLAN_DAY, OPTIONS, SWAP, MACRO_GAP, SHOPPING_DELTA,
/// HOUSEHOLD_SPLIT, CLARIFY — dochodzą po tej samej szynie. Lista wartości
/// żyje w `src/agent/cards/agent-cards.ts`; kolumna jest zwykłym stringiem,
/// więc to spec pilnuje, żeby `kind` zgadzał się z `card.kind`.
///
/// `text` MUSI bronić się sam także wtedy, gdy jest karta: stary klient jej
/// nie zrenderuje, a wiadomość ma nadal nieść sensowne zdanie.
/// `clientMessageId` (UUID z telefonu) jest
/// kluczem idempotencji: retry po timeoucie acka oddaje tę samą turę zamiast
/// drugiego wywołania modelu. `apiContent` to miejsce na dokładne bloki API;
/// DZIŚ NIEUŻYWANE i świadomie: historia rozmowy wraca do modelu jako sam
/// `text`, bo odgrywanie pełnych wyników narzędzi z poprzednich tur kosztowałoby
/// w każdej turze więcej, niż jest warte — model, który potrzebuje szczegółu,
/// woła narzędzie jeszcze raz (patrz docs/plans/scoffie-ai-agent/cost-model.md).
model AgentMessage {
  id              String    @id @default(uuid()) @db.Uuid
  conversationId  String    @db.Uuid
  role            String
  kind            String    @default("TEXT")
  text            String
  /// Treść strukturalna dla klienta — kształt zależny od `kind`, wersjonowany
  /// polem `v`. Świadomie osobno od `apiContent`: tamto jest kontraktem
  /// z DOSTAWCĄ, to jest kontraktem z TELEFONEM.
  card            Json?
  apiContent      Json?
  clientMessageId String?   @db.Uuid
  turnId          String?   @db.Uuid
  createdAt       DateTime  @default(now())
  /// Z czym asystent policzył TĘ odpowiedź: `{ used: string[] }`, np.
  /// „Tydzień 1–7 września", „Dla: Ania, Zosia", „Cel 2 100 kcal". Zapisane
  /// przy odpowiedzi, bo kontekst tury nie wraca — a użytkownik ma złapać, że
  /// asystent wziął złego domownika, patrząc na wiadomość, nie na chipy sprzed
  /// minuty. Tylko dla ASSISTANT; `null` dla pytań i kart zapisu.
  context         Json?
  /// Wiadomość wycofana przez POPRAWIENIE pytania — znika z odczytu, ale
  /// zostaje w bazie. Kasowanie zamieniłoby `AgentTurn` i `AgentProposal`
  /// wskazujące na te wiersze w dziury, a księgę użycia w niepełną.
  hiddenAt        DateTime?

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
}

/// Propozycja asystenta czekająca na klik użytkownika.
///
/// Nic nie zapisuje się samo: model PROPONUJE (stan docelowy ląduje w
/// `action`), a zapis dzieje się dopiero na `POST /agent/proposals/:id/apply`.
/// Podział jest istotny — `card` to WIDOK (nazwy, kalorie; kopia tego, co
/// widać w wiadomości), `action` to INTENCJA (identyfikatory), która NIGDY nie
/// idzie na drut. Klient przysyła sam `proposalId`, więc nie ma jak podmienić
/// tego, co się zapisze.
///
/// `baselineHash` to odcisk tygodnia z chwili propozycji, `appliedHash` — po
/// zapisie. Pierwszy wykrywa zmianę spod ręki (propozycja robi się `STALE`),
/// drugi broni „Cofnij" przed skasowaniem cudzej pracy.
///
/// `messageId` puste = tura nie domknęła się i propozycja jest nieosiągalna;
/// to celowe, bo karty nikt nigdy nie zobaczył.
model AgentProposal {
  /// `dbgenerated`, nie `uuid()`: migracja tej tabeli była pisana ręcznie
  /// z `DEFAULT gen_random_uuid()` i tak stoi na produkcji. Schema musi mówić
  /// to samo, co baza — inaczej `migrate dev` widzi rozjazd i żąda resetu.
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId  String    @db.Uuid
  turnId          String    @db.Uuid
  /// Kopia z rozmowy — sprawdzenie właściciela bez joina.
  userId          String    @db.Uuid
  householdId     String    @db.Uuid
  /// PLAN_WEEK; kolejne rodzaje dochodzą razem z kartami.
  kind            String
  weekStart       DateTime  @db.Date
  action          Json
  card            Json
  baselineHash    String
  appliedHash     String?
  /// PENDING | APPLIED | UNDONE | STALE | EXPIRED | FAILED
  status          String    @default("PENDING")
  messageId       String?   @unique @db.Uuid
  undoSnapshot    Json?
  appliedAt       DateTime?
  appliedByUserId String?   @db.Uuid
  undoneAt        DateTime?
  /// Okres (`YYYY-MM`), z którego zeszła kwota planu przy zapisie; `null`
  /// = nic nie zeszło (zapis bez zmian, kwota oddana). Cofnięcie zwraca
  /// kwotę TYLKO wtedy i TAM — nie do bieżącego miesiąca.
  quotaPeriodKey  String?
  /// Zakres licznika kwoty planu — jak `AgentTurn.quotaScopeId`.
  quotaScopeId    String?
  /// Ile pozycji zmienił zapis; 0 = „Cofnij" nie ma czego cofać.
  changedCount    Int?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([householdId, status])
  @@index([turnId])
}

/// Jedno przetworzenie wiadomości użytkownika: RUNNING | DONE | FAILED |
/// LIMITED (globalny budżet zatrzymał turę w trakcie). Lease „jedna tura naraz
/// w rozmowie" liczy się po statusie w transakcji; `progress` to lista
/// kroków dla ekranu postępu; koszt w mikrodolarach (Int, bez floatów).
model AgentTurn {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  /// Kopia z rozmowy — sprawdzenie właściciela i indeks bez joina.
  userId         String    @db.Uuid
  userMessageId  String    @db.Uuid
  status         String    @default("RUNNING")
  progress       Json      @default("[]")
  /// Narastający tekst odpowiedzi w TRAKCIE tury (streaming z modelu przez
  /// odpytywanie). Prawdą po domknięciu jest `AgentMessage`; tu zostaje NULL.
  draftText      String?
  errorCode      String?
  requestId      String
  provider       String?
  model          String?
  inputTokens    Int       @default(0)
  outputTokens   Int       @default(0)
  costMicroUsd   Int       @default(0)
  durationMs     Int?
  /// Czy kwota wiadomości wróciła po porażce — rozkład zużycia na domowników
  /// liczy tylko tury, które naprawdę zjadły wiadomość.
  quotaRefunded  Boolean   @default(false)
  /// Klucz okresu licznika, z którego zeszła wiadomość (`YYYY-MM` albo
  /// `trial`). Zwrot idzie dokładnie tam — nie do „miesiąca startu", bo pula
  /// próbna nie ma miesiąca. `null` = tura sprzed tej kolumny.
  quotaPeriodKey String?
  /// Zakres licznika, z którego zeszła wiadomość: `sub:<id>` (subskrypcja),
  /// `trial:<hasz>` (pula próbna osoby) albo UUID gospodarstwa (nadanie).
  /// Bez tego zwrot po nieudanej turze trafiał do zakresu wyliczonego W
  /// CHWILI ZWROTU — a dom, który w międzyczasie stracił PRO, dostawał zwrot
  /// do cudzej puli. `null` = tura sprzed tej kolumny (zwrot idzie do domu).
  quotaScopeId   String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  conversation AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  usage        AiUsage[]

  @@unique([userMessageId])
  @@index([conversationId, status])
  @@index([userId, createdAt])
}

/// Jeden wiersz na FAZĘ tury (model + wysiłek) — surowiec do kalibracji modelu
/// kosztów (tokeny z cache osobno, latencja, powód zatrzymania).
///
/// KOMENTARZ MÓWIŁ „jeden wiersz na żądanie do API" I BYŁ NIEPRAWDZIWY od
/// chwili, gdy tura dostała fazy: `AgentTurnRunner.usageRows` dopisuje jeden
/// wiersz na fazę, a nie na żądanie. Ile żądań poszło w tej fazie, mówi
/// dopiero `apiCalls` — bez tej kolumny z produkcji nie dawało się policzyć
/// ani mediany, ani ogona rund, czyli jedynych liczb, po których widać
/// pętlę narzędzi.
model AiUsage {
  id               String   @id @default(uuid()) @db.Uuid
  /// Nullable od 2.09.2026: księga kosztów to dane ROZLICZENIOWE i musi
  /// przeżyć kasowanie rozmów (porządki użytkownika, retencja 90 dni) —
  /// wcześniej kaskada z tury zabierała ją razem z rozmową, więc rachunek
  /// systematycznie „malał". Wiersz bez tury nadal niesie userId, householdId,
  /// tokeny i koszt.
  turnId           String?  @db.Uuid
  userId           String?  @db.Uuid
  householdId      String?  @db.Uuid
  provider         String
  model            String
  effort           String?
  stopReason       String?
  inputTokens      Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  outputTokens     Int      @default(0)
  costMicroUsd     Int      @default(0)
  /// Ile żądań do modelu złożyło się na ten wiersz (1 + rundy narzędziowe
  /// tej fazy). Nullable CELOWO: wiersze sprzed 7.09.2026 tej liczby nie
  /// znają, a `0` znaczyłoby „zero żądań" — czyli nieprawdę wyglądającą jak
  /// pomiar. `NULL` znaczy „nie wiadomo" i tak też liczą to raporty.
  apiCalls         Int?
  latencyMs        Int?
  createdAt        DateTime @default(now())

  turn AgentTurn? @relation(fields: [turnId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Liczniki atomowe na Postgresie (bez Redis): `scopeId` = id gospodarstwa
/// albo `global`, `periodKey` = `YYYY-MM` (kwoty) albo `YYYY-MM-DD` (budżet
/// dzienny), `kind` = messages | plans | costMicroUsd. Kwota sprawdzana i
/// naliczana jednym warunkowym UPDATE — dwa telefony nie przeskoczą limitu.
model AiUsageCounter {
  scopeId   String
  periodKey String
  kind      String
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([scopeId, periodKey, kind])
}

model RecipeIngredient {
  id               String   @id @default(uuid()) @db.Uuid
  recipeId         String   @db.Uuid
  ingredientId     String   @db.Uuid
  name             String
  amount           Float
  unit             String
  normalizedAmount Float
  normalizedUnit   String
  department       String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([recipeId, ingredientId])
  @@index([recipeId])
  @@index([ingredientId])
}

model ShoppingItemCheck {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @db.Uuid
  weekStart   DateTime
  productKey  String
  isChecked   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, weekStart, productKey])
  @@index([householdId, weekStart])
}

model ShoppingList {
  id           String   @id @default(uuid()) @db.Uuid
  householdId  String   @db.Uuid
  weekStart    DateTime
  isStale      Boolean  @default(false)
  /// Wersja reguł liczenia, według których zbudowano tę migawkę
  /// (`SHOPPING_LIST_RULES_VERSION` w `shopping-list.service.ts`). Starsza =
  /// przebudowa przy najbliższym odczycie — zmiana reguł nie wymaga
  /// masowego `UPDATE` na produkcji.
  rulesVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  household Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items     ShoppingListItem[]

  @@unique([householdId, weekStart])
  @@index([householdId, updatedAt])
}

model ShoppingListItem {
  id             String   @id @default(uuid()) @db.Uuid
  shoppingListId String   @db.Uuid
  productKey     String
  name           String
  unit           String
  department     String
  totalAmount    Float
  isChecked      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shoppingList ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)

  @@unique([shoppingListId, productKey])
  @@index([shoppingListId])
}

/// Pozycja dopisana do listy zakupów RĘCZNIE, spoza planu — „brakuje mi"
/// ze szczegółu przepisu.
///
/// Lista zakupów jest liczona z planu (`PlanItem`) i tego się nie zmienia:
/// ta tabela jest jej DRUGIM źródłem, sumowanym pod tym samym `productKey`.
/// To NIE jest spiżarnia — aplikacja dalej nie wie, co stoi w szafce; wie
/// tylko, co ktoś świadomie dopisał, i z którego przepisu.
///
/// Klucz `(householdId, weekStart, recipeId, productKey)`: ponowne dopisanie
/// tego samego przepisu PODMIENIA ilość (np. po zmianie porcji), zamiast
/// dublować ją drugim stuknięciem.
model ShoppingListExtra {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @db.Uuid
  weekStart   DateTime
  recipeId    String   @db.Uuid
  productKey  String
  name        String
  unit        String
  department  String
  amount      Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  recipe    Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([householdId, weekStart, recipeId, productKey])
  @@index([householdId, weekStart])
  @@index([recipeId])
}

model ShoppingListArchive {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @db.Uuid
  weekStart   DateTime
  weekLabel   String
  revision    Int
  signature   String
  archivedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household     Household                  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items         ShoppingListArchiveItem[]
  currentStates ShoppingListArchiveState[] @relation("CurrentShoppingListArchive")

  @@unique([householdId, weekStart, revision])
  @@unique([householdId, weekStart, signature])
  @@index([householdId, archivedAt])
  @@index([householdId, weekStart])
}

model ShoppingListArchiveItem {
  id          String   @id @default(uuid()) @db.Uuid
  archiveId   String   @db.Uuid
  productKey  String
  name        String
  unit        String
  department  String
  totalAmount Float
  isChecked   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  archive ShoppingListArchive @relation(fields: [archiveId], references: [id], onDelete: Cascade)

  @@unique([archiveId, productKey])
  @@index([archiveId])
}

model ShoppingListArchiveState {
  id               String   @id @default(uuid()) @db.Uuid
  householdId      String   @db.Uuid
  weekStart        DateTime
  currentArchiveId String?  @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  household      Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  currentArchive ShoppingListArchive? @relation("CurrentShoppingListArchive", fields: [currentArchiveId], references: [id], onDelete: SetNull)

  @@unique([householdId, weekStart])
  @@index([householdId, currentArchiveId])
}

model PushDevice {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  deviceToken     String       @unique
  platform        PushPlatform
  appBundleId     String
  // SANDBOX | PRODUCTION — środowisko APNs, w którym token jest ważny.
  // Tekst, nie enum: obowiązuje tu ta sama defensywna konwencja migracji co
  // przy DailyStepCount.source, a wartości waliduje warstwa DTO.
  apnsEnvironment String?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  lastSeenAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

/// Skrzynka nadawcza poczty. Kod domeny NIGDY nie woła dostawcy w trakcie
/// żądania — wstawia tu wiersz, najlepiej w TEJ SAMEJ transakcji co zmiana,
/// którą mail opisuje. Wysyłką zajmuje się `MailWorkerService`.
///
/// DLACZEGO PRZEZ BAZĘ, A NIE OD RAZU HTTP-em:
///  1. Kasowanie konta to jedna transakcja. Mail wysłany przed nią wychodzi
///     także wtedy, gdy transakcja padnie; wysłany po niej ginie, gdy padnie
///     proces. Wiersz w transakcji rozwiązuje oba przypadki naraz.
///  2. Dostawca ma prawo oddać 429 albo 503. Bez ponowień „witaj w Scoffie"
///     po prostu nie dochodzi i nikt się o tym nie dowiaduje.
///  3. Apple dubluje powiadomienia, a uzgadnianie subskrypcji chodzi co
///     godzinę — bez `dedupeKey` ktoś dostaje trzy razy „subskrypcja wygasła".
///  4. Przy reklamacji „nie dostałem" widać wiersz, status i odpowiedź
///     dostawcy, zamiast zgadywania z logów Railway.
model MailMessage {
  id String @id @default(uuid()) @db.Uuid

  /// Klucz idempotencji zdarzenia, np. `welcome:<userId>` albo
  /// `grace:<subId>:<txId>`. UNIQUE robi całą robotę: druga próba tego samego
  /// zdarzenia odbija się o bazę, zamiast wysyłać drugi mail. Wołający łapie
  /// konflikt i traktuje go jako sukces, bo mail już jest w kolejce.
  dedupeKey String @unique

  /// Identyfikator szablonu (`WELCOME`, `ACCOUNT_DELETED`, …). Tekst, nie enum:
  /// ta sama defensywna konwencja co przy `PushDevice.apnsEnvironment` —
  /// dołożenie szablonu ma być zmianą kodu, nie migracją bazy. Dopuszczalne
  /// wartości pilnuje `MAIL_TEMPLATE_IDS` i test parytetu.
  template String

  /// Adres SKOPIOWANY w chwili kolejkowania, a nie czytany z relacji.
  /// Mail pożegnalny wychodzi już PO skasowaniu konta — gdyby adres wisiał
  /// na `User`, nie byłoby dokąd go wysłać.
  to String

  /// Wskaźnik na konto, wyłącznie do diagnostyki i retencji. `SetNull`, nie
  /// kaskada: kaskada skasowałaby mail pożegnalny w tej samej transakcji,
  /// w której go kolejkujemy.
  userId String? @db.Uuid

  /// Zmienne do podstawienia w szablonie — tylko to, co naprawdę wchodzi do
  /// treści (nazwa wyświetlana, nazwa gospodarstwa, liczby, daty jako tekst).
  /// Nigdy dane, których mail nie pokazuje.
  payload Json

  status   MailStatus @default(QUEUED)
  attempts Int        @default(0)

  /// Kiedy robotnik ma spróbować następnym razem. Zwłoka rośnie
  /// (1 min → 5 → 30 → 2 h → 6 h), bo błąd dostawcy zwykle nie mija w sekundę.
  nextAttemptAt DateTime @default(now())

  /// Ostatni błąd w formie nadającej się do logu — kod i skrót odpowiedzi
  /// dostawcy, bez treści maila.
  lastError String?

  /// Identyfikator wiadomości u dostawcy. Po nim wiąże się webhook o odrzucie
  /// z konkretnym wysłanym mailem.
  providerMessageId String?

  /// Temat w postaci, w jakiej NAPRAWDĘ poszedł. Zapisywany przy wysyłce, bo
  /// szablon w kodzie może się jutro zmienić, a dowód wysyłki ma zostać ten.
  subject String?

  sentAt DateTime?

  /// Kiedy z wiersza wyczyszczono dane osobowe (`to`, `payload`, `subject`).
  /// Retencja: 30 dni od wysyłki zostawia sam dowód nadania, 12 miesięcy
  /// kasuje wiersz. Wiersz przeżywa skasowanie konta, więc bez tego trzymałby
  /// adres i nazwę wyświetlaną osoby, której u nas już nie ma.
  scrubbedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Indeks pod jedyne zapytanie robotnika: „co czeka i jest już wymagalne".
  @@index([status, nextAttemptAt])
  @@index([userId])
  @@index([sentAt])
}

enum MailStatus {
  QUEUED
  /// Zajęte przez robotnika. Stan przejściowy — chroni przed drugą wysyłką
  /// tego samego wiersza, gdy przebieg trwa dłużej niż odstęp pętli.
  SENDING
  SENT
  /// Wyczerpane próby albo odmowa, której nie ma sensu ponawiać.
  FAILED
  /// Świadomie pominięty: brak adresu, adres na liście wykluczeń, poczta
  /// wyłączona. Nie jest błędem i nie budzi alertu.
  SKIPPED
}

/// Adresy, na które nie wysyłamy nigdy więcej: twardy odrzut albo skarga na
/// spam. Zasila je webhook dostawcy.
///
/// Klucz to adres pisany małymi literami, a nie `userId` — wykluczenie ma
/// przeżyć skasowanie konta i objąć konto założone od nowa na ten sam adres.
/// Wysyłanie na adres, który raz twardo odbił, psuje reputację domeny
/// wszystkim pozostałym.
model MailSuppression {
  email String @id

  /// HARD_BOUNCE | COMPLAINT | MANUAL. Tekst, nie enum — dostawcy nazywają
  /// zdarzenia po swojemu i lista bywa dłuższa niż nasza wyobraźnia.
  reason String

  /// Skrót powodu od dostawcy, do wglądu przy reklamacji.
  detail String?

  createdAt DateTime @default(now())
}

// ───────────────────────── PANEL ADMINISTRATORA ─────────────────────────
//
// `docs/plans/scoffie-admin/ROADMAPA.md` §4 i §6. Osobna tożsamość, NIE rola
// na `User`: konto w aplikacji można skasować (RODO), przejęte konto w
// aplikacji nie może dawać panelu, a token dostępu aplikacji nigdy nie otwiera
// `/admin`. Żadnych kluczy obcych do tabel aplikacji — w obie strony.

/// Administrator panelu (warstwa 1 logowania, za bramką Cloudflare Access).
model AdminUser {
  id             String    @id @default(uuid()) @db.Uuid
  /// Adres z tokenu Cloudflare Access, małymi literami. Wiąże warstwę 1 z
  /// bramką: passkey, TOTP i kod odzyskiwania działają WYŁĄCZNIE dla
  /// żądania, które przeszło bramkę z tym adresem.
  email          String    @unique
  displayName    String
  /// Nazwa zestawu uprawnień z `src/admin/admin-permissions.ts` (dziś tylko
  /// OWNER — decyzja D5). Tekst, nie enum: kolejna rola to wpis w kodzie.
  role           String    @default("OWNER")
  /// Uchwyt użytkownika WebAuthn (`user.id` w opcjach rejestracji), base64url.
  /// Losowy, a nie id wiersza: authenticator trzyma go u siebie.
  webauthnUserId String    @unique
  /// Konto wyłączone — nie otwiera sesji, ale zostaje, bo wskazuje na nie
  /// dziennik audytu. Panel nigdy nie kasuje wierszy tej tabeli.
  disabledAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  credentials   AdminCredential[]
  totp          AdminTotp?
  recoveryCodes AdminRecoveryCode[]
  sessions      AdminSession[]
}

/// Passkey admina (WebAuthn): Face ID / Touch ID z pęku kluczy iCloud albo
/// klucz sprzętowy. Kilka na konto, każdy z nazwą nadaną przy rejestracji.
model AdminCredential {
  id           String    @id @default(uuid()) @db.Uuid
  adminUserId  String    @db.Uuid
  /// `credential.id` z WebAuthn (base64url) — po nim szukamy klucza.
  credentialId String    @unique
  publicKey    Bytes
  /// Licznik podpisów z authenticatora; spadek = sklonowany klucz (passkeye
  /// z pęku kluczy iCloud mają stale 0 i to jest poprawne).
  counter      Int       @default(0)
  transports   String[]  @default([])
  /// singleDevice | multiDevice
  deviceType   String
  backedUp     Boolean   @default(false)
  name         String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  admin AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

/// TOTP admina (Google Authenticator). Sekret szyfrowany AES-256-GCM kluczem
/// `ADMIN_TOTP_ENCRYPTION_KEY`, w formacie Cookidoo (`v1:<iv>:<tag>:<ct>`).
model AdminTotp {
  adminUserId            String    @id @db.Uuid
  /// Sekret potwierdzony pierwszym kodem — tylko on otwiera sesję.
  secretEncrypted        String?
  confirmedAt            DateTime?
  /// Ostatni przyjęty krok (unix / 30 s). Kod z tego samego albo starszego
  /// kroku odpada, więc podejrzany kod nie działa drugi raz nawet w swoim
  /// oknie. Przejęcie kroku to warunkowy `updateMany` — dwa równoległe
  /// żądania z tym samym kodem nie przejdą oba.
  lastUsedStep           Int?
  /// Sekret w trakcie konfiguracji: pokazany raz, czeka na pierwszy kod.
  /// Osobna kolumna, żeby nieukończona zmiana nie wyłączyła działającego TOTP.
  pendingSecretEncrypted String?
  pendingCreatedAt       DateTime?
  updatedAt              DateTime  @updatedAt

  admin AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
}

/// Kody odzyskiwania — 10 jednorazowych. W bazie wyłącznie HMAC-SHA256
/// kluczem pochodnym `ADMIN_TOTP_ENCRYPTION_KEY`: wyciek bazy bez klucza nie
/// pozwala ich odtworzyć nawet przeglądem całej przestrzeni.
model AdminRecoveryCode {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @db.Uuid
  codeHash    String    @unique
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  admin AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

/// Sesja panelu. W ciasteczku `__Host-scoffie_admin` leży surowy token, tu
/// wyłącznie jego sha256 — zrzut bazy nie jest kompletem działających sesji
/// (ta sama zasada co `RefreshToken.tokenHash`).
model AdminSession {
  id            String    @id @default(uuid()) @db.Uuid
  adminUserId   String    @db.Uuid
  tokenHash     String    @unique
  /// passkey | totp | recovery — czym otwarto sesję.
  method        String
  /// Wejście kodem odzyskiwania: do czasu nowego passkeya albo TOTP sesja
  /// widzi wyłącznie konfigurację logowania, nie dane.
  mustReenroll  Boolean   @default(false)
  /// Ponowne potwierdzenie (step-up) ważne do tej chwili — 5 minut.
  stepUpUntil   DateTime?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  /// Twardy koniec: 12 h od otwarcia. Bezczynność (30 min) liczy się z
  /// `lastSeenAt`.
  expiresAt     DateTime
  revokedAt     DateTime?
  /// LOGOUT | REVOKED
  revokedReason String?
  /// `CF-Connecting-IP` z Workera panelu (albo adres połączenia).
  ip            String?
  /// `CF-IPCountry`
  country       String?
  userAgent     String?

  admin AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, createdAt])
  @@index([expiresAt])
}

/// Próby logowania i step-upu — z nich liczy się blokada (5 nieudanych w 15
/// minut per adres i per IP). Także dla adresów, które nie są adminem.
model AdminLoginAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  /// Adres z bramki Access, małymi literami.
  email       String
  adminUserId String?  @db.Uuid
  ip          String?
  country     String?
  userAgent   String?
  /// passkey | totp | recovery
  method      String
  /// LOGIN | STEP_UP
  kind        String
  /// SUCCESS | FAILED | LOCKED
  result      String
  /// Kod odmowy (INVALID_CODE, PASSKEY_FAILED, …).
  reason      String?
  createdAt   DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

/// Dziennik audytu panelu — tylko dopisywanie (ROADMAPA §1.2). Każda zmiana
/// z panelu i każde odsłonięcie danych wrażliwych, z powodem. Wiersz powstaje
/// PRZED skutkiem (`PENDING`), więc akcja bez śladu jest niemożliwa nawet
/// wtedy, gdy proces padnie w jej połowie.
model AdminAuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String?   @db.Uuid
  /// Kopia adresu — wpis ma mówić „kto" niezależnie od losów konta admina.
  adminEmail  String
  sessionId   String?   @db.Uuid
  /// np. `household.tier.set`, `user.health.reveal`, `auth.passkey.register`
  action      String
  targetType  String?
  targetId    String?
  reason      String?
  /// Parametry i skutek akcji — bez danych osobowych i bez danych o zdrowiu.
  details     Json?
  /// PENDING → SUCCESS | FAILED
  result      String
  errorCode   String?
  ip          String?
  /// `CF-IPCountry`
  country     String?
  requestId   String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([adminUserId, createdAt])
}

/// Wyzwania WebAuthn między `…/options` a weryfikacją. Jednorazowe (przejęcie
/// warunkowym `updateMany`), ważne 5 minut, związane z adresem z bramki
/// (a przy step-upie — z sesją).
model AdminWebAuthnChallenge {
  id             String    @id @default(uuid()) @db.Uuid
  challenge      String    @unique
  /// LOGIN | REGISTER | STEP_UP
  purpose        String
  email          String
  adminUserId    String?   @db.Uuid
  sessionId      String?   @db.Uuid
  /// Rejestracja pierwszego admina: uchwyt WebAuthn konta, które dopiero powstanie.
  webauthnUserId String?
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([expiresAt])
}

