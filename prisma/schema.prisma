generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String       @id @default(uuid()) @db.Uuid
  googleId              String?      @unique
  appleSub              String?      @unique
  authProvider          AuthProvider @default(GOOGLE)
  displayName           String
  email                 String?
  emailVerified         Boolean      @default(false)
  avatarUrl             String?
  yearOfBirth           Int?
  heightCm              Int?
  // Waga jako Float, nie Int — wagi ciała podaje się z dokładnością do
  // 0,1 kg i zaokrąglanie 83,5 do 84 psuło zarówno BMI, jak i policzone
  // zapotrzebowanie.
  weightKg              Float?
  // Płeć wchodzi wyłącznie do wzoru Mifflina-St Jeora, który różnicuje BMR
  // stałą (+5 / −161). Nullable, bo konta założone wcześniej jej nie mają
  // i wtedy klient liczy ze średniej.
  sex                   Sex?
  // Indeks gradientu awatara, przydzielany raz przy kończeniu onboardingu.
  // Trzymany na serwerze, a nie liczony z hasza na kliencie, bo przydział
  // musi widzieć, jakie kolory zajęli już pozostali domownicy — inaczej
  // dwie osoby w jednym gospodarstwie potrafiłyby wylosować to samo.
  avatarColor           Int?
  onboardingCompletedAt DateTime?
  lastLoginAt           DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  recipes         Recipe[]
  memberships     Membership[]
  createdHomes    Household[]     @relation("HouseholdCreator")
  invitations     Invitation[]    @relation("InvitationCreator")
  acceptedInvites Invitation[]    @relation("InvitationRedeemer")
  /// Zaproszenia leżące w skrzynce tego użytkownika — patrz
  /// `Invitation.invitedUserId`.
  receivedInvites Invitation[]    @relation("InvitationRecipient")
  refreshTokens   RefreshToken[]
  pushDevices     PushDevice[]
  preferences     UserPreference?

  planParticipations PlanItemParticipant[]
  mealConsumptions   PlanItemConsumption[]
}

model UserPreference {
  userId         String              @id @db.Uuid
  dietPreference DietPreferenceValue @default(NONE)
  calorieGoal    Int                 @default(2000)
  allergens      String[]            @default([])
  goal           UserGoal            @default(HEALTHY)
  activityLevel  Int                 @default(2)
  // Makra w gramach. Nullable, bo dopóki uzytkownik ich nie tknie, klient
  // liczy je z celu, sylwetki i liczby treningow — a policzona wartosc ma
  // podazac za zmianami tamtych, nie zamrazac sie w bazie. Zapisujemy je
  // dopiero, gdy ktos je nadpisze recznie.
  proteinG       Int?
  fatG           Int?
  carbsG         Int?

  /// Kanały powiadomień push. Do tej pory przełączniki z Ustawień żyły
  /// wyłącznie w `UserDefaults` na telefonie, więc wyciszenie powiadomień
  /// uciszało tylko lokalne bannery, a pushe z serwera leciały dalej —
  /// z perspektywy użytkownika główny przełącznik był popsuty. Serwer musi
  /// znać te wartości, bo to on decyduje, czy w ogóle wysłać.
  pushPlanChanges   Boolean @default(true)
  pushShoppingList  Boolean @default(true)
  pushHousehold     Boolean @default(true)

  /// Cisza nocna. Zbiorcze podsumowania (plan, lista zakupów) nie wychodzą
  /// między 22:00 a 7:00 czasu użytkownika — czekają na koniec okna. Dołączenie
  /// domownika jej nie podlega: to zdarzenie jednorazowe, na które ktoś czeka.
  pushQuietHours    Boolean @default(true)

  /// Strefa czasowa IANA z telefonu (`TimeZone.current.identifier`). Bez niej
  /// cisza nocna liczyłaby się w strefie kontenera, czyli zwykle w UTC —
  /// a to przesuwa okno o dwie godziny w polskim lecie.
  timeZone          String?

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Recipe {
  id                    String     @id @default(uuid()) @db.Uuid
  title                 String
  description           String?
  sourceProvider        String?
  sourceRecipeId        String?
  sourceCategory        String?
  sourceCuisine         String?
  sourceTags            String[]   @default([])
  sourceMeta            Json?
  sourceDietary         Json?
  sourceStorage         Json?
  sourceEquipment       Json?
  sourceInstructions    Json?
  sourceTroubleshooting Json?
  sourceChefNotes       Json?
  sourceCulturalContext String?
  sourceNutrition       Json?
  sourceRaw             Json?
  /// Slot, do którego przepis należy „z natury" — steruje sekcją na
  /// Przepisach, okładką i akcentem. Zawsze dokładnie jeden.
  mealType              MealType
  /// Wszystkie sloty, w których danie ma sens. Zawiera `mealType` plus te
  /// dołożone ręcznie albo przez klasyfikator (`suitable-meal-types.util`).
  /// To ono, a nie `mealType`, decyduje o tym, co widać przy dodawaniu
  /// posiłku do slotu — dzięki temu jedna owsianka wpada i na śniadanie,
  /// i na II śniadanie, bez duplikowania przepisu.
  /// Puste = brak backfillu; czytający traktują to jak `[mealType]`.
  suitableMealTypes     MealType[] @default([])
  difficulty            Difficulty @default(EASY)
  prepTimeMinutes       Int        @default(0)
  servings              Int        @default(1)
  imageUrl              String?
  nutritionKcal         Float      @default(0)
  nutritionProtein      Float      @default(0)
  nutritionFat          Float      @default(0)
  nutritionCarbs        Float      @default(0)
  nutritionFiber        Float      @default(0)
  nutritionSalt         Float      @default(0)
  isActive              Boolean    @default(true)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  authorId    String    @db.Uuid
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  householdId String    @db.Uuid
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  planItems           PlanItem[]
  ingredients         RecipeIngredient[]
  favorites           RecipeFavorite[]
  sharedMealPlanItems SharedMealPlanItem[]

  // GIN — zapytania po slocie idą teraz przez `suitableMealTypes has X`,
  // a B-tree nie obsłuży zawierania w tablicy.
  @@index([suitableMealTypes], type: Gin)
}

model Ingredient {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @unique
  normalizedName String   @unique
  category       String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Wartosci odzywcze na 100 g (jednostka `g`) lub 100 ml (jednostka `ml`),
  // stan surowy. `nutritionCarbsPer100` to weglowodany przyswajalne, bez
  // blonnika. Nullable: nowy skladnik bez makro ma sie dodac, audyt zglosi
  // go jako luke. Zrodlo: prisma/catalog/ingredient-nutrition-pl-v1.json
  nutritionKcalPer100    Float?
  nutritionProteinPer100 Float?
  nutritionCarbsPer100   Float?
  nutritionFatPer100     Float?
  nutritionFiberPer100   Float?

  /// Masa jadalnej czesci 1 sztuki — dla skladnikow mierzonych w `szt`.
  gramsPerPiece Float?

  /// Skad pochodza powyzsze wartosci, np. "ingredient-nutrition-pl-v1".
  nutritionSource String?

  aliases           IngredientAlias[]
  recipeIngredients RecipeIngredient[]
}

model IngredientAlias {
  id              String   @id @default(uuid()) @db.Uuid
  ingredientId    String   @db.Uuid
  alias           String   @unique
  normalizedAlias String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([ingredientId])
}

model Household {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  /// Sloty posiłków, które gospodarstwo planuje. Trzymane per gospodarstwo,
  /// a nie per użytkownik, bo plan tygodnia i lista zakupów są wspólne —
  /// gdyby Ania miała podwieczorek, a Marek nie, jedno z nich widziałoby
  /// plan z dziurą i listę zakupów, która się z nim nie zgadza.
  /// Trójka BREAKFAST/LUNCH/DINNER jest obowiązkowa i walidowana w serwisie.
  enabledMealTypes MealType[] @default([BREAKFAST, LUNCH, DINNER])
  /// Pory posiłków: mapa slot → minuty od północy, np. `{"BREAKFAST": 480}`.
  /// Minuty, nie `DateTime`, bo pora posiłku to punkt w dobie — `DateTime`
  /// wciągnąłby tu datę i strefę czasową, których ta wartość nie ma.
  /// `null` = gospodarstwo nie ruszało godzin (klient bierze swoje domyślne).
  /// Brak klucza = ten posiłek nie ma stałej pory (tak działa przekąska),
  /// więc pusta mapa i `null` znaczą co innego.
  mealSlotTimes Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?  @db.Uuid
  createdBy   User?    @relation("HouseholdCreator", fields: [createdById], references: [id], onDelete: SetNull)

  memberships               Membership[]
  recipes                   Recipe[]
  invitations               Invitation[]
  weeklyPlans               WeeklyPlan[]
  shoppingLists             ShoppingList[]
  shoppingItemChecks        ShoppingItemCheck[]
  shoppingListArchives      ShoppingListArchive[]
  shoppingListArchiveStates ShoppingListArchiveState[]
  recipeFavorites           RecipeFavorite[]
  sharedMealPlans           SharedMealPlan[]
}

model RecipeFavorite {
  id          String   @id @default(uuid()) @db.Uuid
  recipeId    String   @db.Uuid
  householdId String   @db.Uuid
  createdAt   DateTime @default(now())

  recipe    Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([recipeId, householdId])
  @@index([householdId])
}

model Membership {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  householdId String         @db.Uuid
  role        MembershipRole @default(MEMBER)
  createdAt   DateTime       @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
}

model Invitation {
  id           String    @id @default(uuid()) @db.Uuid
  token        String    @unique
  householdId  String    @db.Uuid
  createdById  String?   @db.Uuid
  redeemedById String?   @db.Uuid
  expiresAt    DateTime
  redeemedAt   DateTime?
  createdAt    DateTime  @default(now())

  /// Komu to zaproszenie leży w skrzynce.
  ///
  /// Zaproszenie powstaje jako anonimowy link — właściciel wysyła go dowolnym
  /// komunikatorem i w chwili tworzenia NIE WIADOMO, kto go otworzy. Adresat
  /// zapisuje się dopiero wtedy, gdy ktoś link podejrzy
  /// (`households:previewInvitation`), i to jest jedyny moment, w którym
  /// aplikacja poznaje odbiorcę. Zapraszanie po e-mailu nie zastąpiłoby tego:
  /// przy Sign in with Apple adres bywa przekierowaniem `@privaterelay`,
  /// którego zapraszający nie zna.
  ///
  /// To pole NIE zawęża, kto może zaproszenie przyjąć — link zostaje
  /// wielorazowy do czasu wykorzystania. Służy wyłącznie do tego, żeby
  /// zaproszenie dało się później odnaleźć w aplikacji zamiast szukać
  /// w historii czatu.
  invitedUserId String?  @db.Uuid
  invitedUser   User?    @relation("InvitationRecipient", fields: [invitedUserId], references: [id], onDelete: SetNull)

  /// Kiedy adresat świadomie odmówił. Odrzucone znika ze skrzynki, ale zostaje
  /// w bazie — inaczej ten sam link odłożyłby się tam z powrotem przy
  /// pierwszym podejrzeniu.
  declinedAt DateTime?

  household  Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy  User?     @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  redeemedBy User?     @relation("InvitationRedeemer", fields: [redeemedById], references: [id], onDelete: SetNull)

  @@index([invitedUserId])
}

model WeeklyPlan {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @db.Uuid
  weekStart   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items     PlanItem[]

  @@unique([householdId, weekStart])
}

model PlanItem {
  id           String    @id @default(uuid()) @db.Uuid
  weeklyPlanId String    @db.Uuid
  recipeId     String    @db.Uuid
  dayOfWeek    DayOfWeek
  mealType     MealType
  createdAt    DateTime  @default(now())

  /// Ile porcji przepisu faktycznie gotujemy w tym slocie. To liczba łączna,
  /// nie „na osobę". Lista zakupów skaluje składniki przez
  /// `plannedServings / recipe.servings`.
  ///
  /// Domyślnie tyle, ile osób je danie (pusty `participants` = całe
  /// gospodarstwo), ale użytkownik może to nadpisać stepperem w szczegółach
  /// posiłku. `@default(1)` jest tylko po to, żeby ALTER TABLE przeszedł na
  /// istniejących wierszach — prawdziwe wartości wylicza z audytorium ta sama
  /// migracja, tuż po dodaniu kolumny. Skrypt
  /// `scripts/backfill-plan-item-servings.ts` został jako narzędzie naprawcze
  /// dla baz, które przeszły migrację bez tego kroku.
  plannedServings Int @default(1)

  weeklyPlan   WeeklyPlan            @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  recipe       Recipe                @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  participants PlanItemParticipant[]
  consumptions PlanItemConsumption[]

  // A (day, mealType) slot can hold several items — one per recipe — so the
  // household can split a meal ("Ania eats a salad, Marek a schnitzel").
  // Uniqueness is recipe-aware to keep the same recipe from being added twice
  // to one slot.
  @@unique([weeklyPlanId, dayOfWeek, mealType, recipeId])
  @@index([weeklyPlanId, dayOfWeek, mealType])
}

/// Which household members a given plan item is for.
/// An empty participant set means "everyone" — that keeps every pre-split row
/// valid without a backfill, and is what the app renders as „Wspólne".
model PlanItemParticipant {
  planItemId String   @db.Uuid
  userId     String   @db.Uuid
  createdAt  DateTime @default(now())

  planItem PlanItem @relation(fields: [planItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([planItemId, userId])
  @@index([planItemId])
  @@index([userId])
}

/// Who actually ate a planned meal, and when.
///
/// Per-user rather than a flag on PlanItem: a shared item („Wspólne", no
/// participant rows) is eaten by each member on their own schedule, so one
/// boolean could not answer „did *I* eat this?". Row present = eaten.
model PlanItemConsumption {
  planItemId String   @db.Uuid
  userId     String   @db.Uuid
  eatenAt    DateTime @default(now())

  planItem PlanItem @relation(fields: [planItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([planItemId, userId])
  @@index([planItemId])
  @@index([userId])
}

model RecipeIngredient {
  id               String   @id @default(uuid()) @db.Uuid
  recipeId         String   @db.Uuid
  ingredientId     String   @db.Uuid
  name             String
  amount           Float
  unit             String
  normalizedAmount Float
  normalizedUnit   String
  department       String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([recipeId])
  @@index([ingredientId])
}

model ShoppingItemCheck {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @db.Uuid
  weekStart   DateTime
  productKey  String
  isChecked   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, weekStart, productKey])
  @@index([householdId, weekStart])
}

model ShoppingList {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @db.Uuid
  weekStart   DateTime
  isStale     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items     ShoppingListItem[]

  @@unique([householdId, weekStart])
  @@index([householdId, updatedAt])
}

model ShoppingListItem {
  id             String   @id @default(uuid()) @db.Uuid
  shoppingListId String   @db.Uuid
  productKey     String
  name           String
  unit           String
  department     String
  totalAmount    Float
  isChecked      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shoppingList ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)

  @@unique([shoppingListId, productKey])
  @@index([shoppingListId])
}

model ShoppingListArchive {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @db.Uuid
  weekStart   DateTime
  weekLabel   String
  revision    Int
  signature   String
  archivedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household     Household                  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items         ShoppingListArchiveItem[]
  currentStates ShoppingListArchiveState[] @relation("CurrentShoppingListArchive")

  @@unique([householdId, weekStart, revision])
  @@unique([householdId, weekStart, signature])
  @@index([householdId, archivedAt])
  @@index([householdId, weekStart])
}

model ShoppingListArchiveItem {
  id          String   @id @default(uuid()) @db.Uuid
  archiveId   String   @db.Uuid
  productKey  String
  name        String
  unit        String
  department  String
  totalAmount Float
  isChecked   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  archive ShoppingListArchive @relation(fields: [archiveId], references: [id], onDelete: Cascade)

  @@unique([archiveId, productKey])
  @@index([archiveId])
}

model ShoppingListArchiveState {
  id               String   @id @default(uuid()) @db.Uuid
  householdId      String   @db.Uuid
  weekStart        DateTime
  currentArchiveId String?  @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  household      Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  currentArchive ShoppingListArchive? @relation("CurrentShoppingListArchive", fields: [currentArchiveId], references: [id], onDelete: SetNull)

  @@unique([householdId, weekStart])
  @@index([householdId, currentArchiveId])
}

model SharedMealPlan {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String   @db.Uuid
  weekStart   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items     SharedMealPlanItem[]

  @@unique([householdId, weekStart])
}

model SharedMealPlanItem {
  id               String   @id @default(uuid()) @db.Uuid
  sharedMealPlanId String   @db.Uuid
  recipeId         String   @db.Uuid
  mealType         MealType
  quantity         Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sharedMealPlan SharedMealPlan @relation(fields: [sharedMealPlanId], references: [id], onDelete: Cascade)
  recipe         Recipe         @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([sharedMealPlanId, mealType, recipeId])
  @@index([sharedMealPlanId, mealType])
}

model PushDevice {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  deviceToken String       @unique
  platform    PushPlatform
  appBundleId String
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  lastSeenAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

enum MembershipRole {
  OWNER
  MEMBER
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

/// Sloty posiłków w ciągu dnia. Kolejność definicji jest istotna: Postgres
/// sortuje enum po niej, a `orderBy: { mealType: 'asc' }` w planach tygodnia
/// ma dawać porządek dnia (śniadanie → II śniadanie → obiad → …), nie
/// alfabetyczny. Migracja dokłada nowe wartości `BEFORE`/`AFTER` istniejących,
/// żeby ten porządek utrzymać bez przepisywania typu.
enum MealType {
  BREAKFAST
  SECOND_BREAKFAST
  LUNCH
  AFTERNOON_SNACK
  DINNER
  SNACK
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum PushPlatform {
  IOS
}

enum AuthProvider {
  GOOGLE
  APPLE
  DEV
}

enum Sex {
  MALE
  FEMALE
}

enum DietPreferenceValue {
  NONE
  VEGETARIAN
  VEGAN
  PESCATARIAN
  KETO
  PALEO
  HIGH_PROTEIN
}

enum UserGoal {
  HEALTHY
  LOSE
  GAIN
  MAINTAIN
  PLAN
}
