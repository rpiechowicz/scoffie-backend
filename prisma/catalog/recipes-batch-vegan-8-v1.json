    {
      "id": "bc27ded2-ca00-4797-8f26-767f7959b9e7",
      "title": "Owsianka na mleku owsianym z masłem orzechowym",
      "description": "Kremowa owsianka gotowana na mleku owsianym, z masłem orzechowym, bananem i cynamonem. Sycące śniadanie bez nabiału, gotowe w kwadrans.",
      "mealType": "BREAKFAST",
      "suitableMealTypes": [
        "BREAKFAST",
        "SECOND_BREAKFAST"
      ],
      "difficulty": "EASY",
      "prepTimeMinutes": 12,
      "servings": 2,
      "nutrition": {
        "kcal": 943,
        "protein": 31,
        "carbs": 112,
        "fat": 36,
        "fiber": 21,
        "salt": 0.5
      },
      "steps": [
        {
          "step": 1,
          "instruction": "Wsyp płatki owsiane do garnka, zalej mlekiem owsianym i zagotuj na średnim ogniu, mieszając."
        },
        {
          "step": 2,
          "instruction": "Zmniejsz ogień i gotuj około 5 minut, aż płatki napęcznieją, a owsianka zgęstnieje."
        },
        {
          "step": 3,
          "instruction": "Zdejmij z ognia, wmieszaj masło orzechowe i cynamon."
        },
        {
          "step": 4,
          "instruction": "Przełóż do miseczek, ułóż na wierzchu banana pokrojonego w plasterki i posyp pestkami dyni."
        }
      ],
      "ingredients": [
