DATABASE_URL=postgresql://weeklymeals:weeklymeals@localhost:5432/weeklymeals?schema=public
JWT_SECRET=replace-me
JWT_EXPIRES_IN=30d
REFRESH_TOKEN_DAYS=30
REFRESH_TOKEN_PEPPER=replace-me
WS_CORS_ORIGIN=*

# Image generation (URL-based)
IMAGE_GENERATOR_PROVIDER=pollinations
IMAGE_GENERATOR_BASE_URL=https://image.pollinations.ai/prompt
IMAGE_GENERATOR_QUERY=width=1200&height=800&nologo=true
IMAGE_GENERATOR_STYLE=ultra realistic food photography, natural light, 50mm lens, shallow depth of field
IMAGE_GENERATOR_SEED_PREFIX=weekly-meals
IMAGE_HOUSEHOLD_NAME=Home
IMAGE_RECIPE_LIMIT=0
IMAGE_OVERWRITE_EXISTING=false

# Cloudflare R2 image storage (recommended)
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Option A: provide account id and endpoint is computed
R2_ACCOUNT_ID=
# Option B: set explicit endpoint, e.g. https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Public bucket domain or custom domain serving files
R2_PUBLIC_BASE_URL=
R2_KEY_PREFIX=recipe-images
R2_OVERWRITE_EXISTING=false

# APNs push notifications (optional, production)
APNS_ENABLED=false
APNS_USE_SANDBOX=true
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
# Single-line PEM (replace real newlines with \n)
APNS_PRIVATE_KEY=

# Recipes list cache (backend)
RECIPES_LIST_CACHE_ENABLED=true
RECIPES_LIST_CACHE_TTL_SECONDS=90

# JSON recipes import (manual/local)
RECIPE_IMPORT_FILE=prisma/catalog/recipes-batch-test-v1.json
RECIPE_IMPORT_CLEAR_EXISTING=false
RECIPE_IMPORT_OWNER_USER_ID=11111111-1111-4111-8111-111111111111
RECIPE_IMPORT_OWNER_LEGACY_SUB=legacy-recipe-import-owner
RECIPE_IMPORT_OWNER_DISPLAY_NAME=Recipe Import Bot
RECIPE_IMPORT_OWNER_EMAIL=recipe-import-bot@example.com
RECIPE_IMPORT_HOUSEHOLD_NAME=Home
