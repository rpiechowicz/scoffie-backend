PORT=3000
DATABASE_URL=postgresql://scoffie:scoffie@localhost:5432/scoffie?schema=public

# Auth
# Na produkcji (NODE_ENV=production) serwer odmawia startu, gdy JWT_SECRET
# albo REFRESH_TOKEN_PEPPER ma <32 znaki, wartość z tego pliku/CI, albo gdy
# oba są równe. Wygeneruj: openssl rand -base64 32 (osobno dla każdego).
JWT_SECRET=replace-me
# Życie access tokenu. Domyślnie w kodzie 1h i tyle ma być na produkcji:
# logout unieważnia tylko refresh token, więc skradziony access token żyje
# do `exp`. Dawne 30d oznaczało miesiąc dostępu po wylogowaniu. iOS odświeża
# sam (refresh token niżej).
JWT_EXPIRES_IN=1h
# Refresh dłuższy niż access: odświeżenie po wygaśnięciu access tokenu musi
# trafić w żywy refresh token.
REFRESH_TOKEN_DAYS=60
REFRESH_TOKEN_PEPPER=replace-me
# Okno laski na ZGUBIONA ODPOWIEDZ z rotacji refresh tokenu. Telefon wysyla
# refresh, serwer rotuje, iOS uspia proces i odpowiedz nie dojezdza — stary
# token wraca przy nastepnym starcie. W oknie (liczonym od rotacji) taki token
# dostaje swieza pare, o ile jego nastepca zyje i nikt go nie uzyl. Co dzieje
# sie PO oknie, rozstrzyga REFRESH_STRICT_REUSE nizej.
REFRESH_REUSE_GRACE_SECONDS=60
# Stary, zrotowany token wraca PO oknie laski, a jego nastepcy nikt nie uzyl.
# true (DOMYSLNIE — takze przy braku zmiennej, pustej wartosci i literowce):
#   to replay — pada CALA rodzina tokenow usera (wylogowanie ze wszystkich
#   urzadzen + uniewaznienie tokenow dostepu). Cena: te sama kare dostaje
#   wlasciciel telefonu, ktory zgubil odpowiedz i wrocil po oknie.
# false (WYLACZNIE jawne `false`): telefon dostaje swieza pare takze po oknie
#   („recovered COLD" w logu). Cena: kopia starego tokenu tez ja dostaje — i
#   ZOSTAJE, bo para z ratunku nie jest spieta z lancuchem, wiec pozniejsze
#   uzycie nastepcy przez wlasciciela niczego juz nie wykrywa.
# Rozwidlenie lancucha (nastepca UZYTY) kasuje rodzine w OBU trybach.
# PRZED WDROZENIEM sprawdz wartosc na Railway: jawne `false` ustawione tam
# wczesniej nadal wygrywa z nowa wartoscia domyslna.
REFRESH_STRICT_REUSE=true
# Opt-in. Brak zmiennej = dev-login wyłączony. Na produkcji MUSI być false.
AUTH_DEV_LOGIN_ENABLED=true
# Nagłówek x-ops-token dla tras /ops/* (metryki, billing, tier). Pusty = trasy
# ZAMKNIĘTE (403) w każdym środowisku; na produkcji pusty blokuje start.
# Lokalnie: openssl rand -base64 24
OPS_TOKEN=

# HTTP / WS CORS
CORS_ORIGIN=http://localhost:5173
# Źródła dopuszczone do socketu. Brak zmiennej = ta sama lista, co CORS_ORIGIN
# (plus localhost:5173 poza produkcją). Na produkcji `*` NIE działa (blokada).
WS_CORS_ORIGIN=
# Uściski dłoni socketu na adres IP i minutę, sprawdzane przed tokenem; 0 wyłącza.
WS_HANDSHAKE_RATE_LIMIT=300
# Uwierzytelnianie WebSocketu (JWT w handshake: `auth: { token }` albo nagłówek
# Authorization: Bearer). `strict`: brak tokenu = odmowa handshake'u — TAK
# działa produkcja (domyślnie, gdy brak zmiennej). `soft`: socket BEZ tokenu
# wchodzi jako legacy z userId z payloadu, czyli każdy może podszyć się pod
# każdego — TYLKO dla lokalnych narzędzi (`pnpm ws:smoke`); na produkcji
# serwer odmawia startu przy `soft`. NIE kopiować tej linii na Railway.
WS_AUTH_MODE=soft

# --- Limity żądań (throttler) ---
# Wszystkie mają wartości domyślne i są czytane PER ŻĄDANIE, więc zmiana na
# Railway działa po restarcie, bez nowego builda. Zła wartość (nie-liczba, < 1)
# jest ignorowana i zgłaszana przy starcie. Limity per minutę.
# Zwykły ruch: per użytkownik (po zweryfikowanym tokenie), inaczej per IP.
THROTTLE_DEFAULT_LIMIT=120
# Twarda siatka na adres IP — nie ruszają jej limity per kontroler.
THROTTLE_IP_LIMIT=300
# /auth/* per IP: bariera na zgadywanie, nie na pętlę w kliencie.
THROTTLE_AUTH_LIMIT=20
# Asystent: wysyłka wiadomości (droga) i polling tury (tani).
THROTTLE_AGENT_MESSAGE_LIMIT=20
THROTTLE_AGENT_POLL_LIMIT=120
# Limit zdarzeń WebSocketu per użytkownik (guard Nesta omija ack, więc limiter
# siedzi w `actorId`). 0 = wyłączony.
WS_RATE_LIMIT_PER_MIN=120

# --- Asystent AI (src/agent) ---
# Opt-in. Brak zmiennej = asystent wyłączony, każdy endpoint /agent oddaje 503
# AI_DISABLED. Wszystkie AI_* mają wartości domyślne — merge nie wymaga
# ustawiania niczego na Railway.
AI_ENABLED=false
# anthropic (domyślny) albo stub (odpowiedzi bez wywołania modelu; e2e).
AI_PROVIDER=anthropic
# Wymagany TYLKO przy AI_ENABLED=true + AI_PROVIDER=anthropic. Bez klucza
# asystent zachowuje się jak wyłączony (nie zdejmuje kwoty i nie płaci).
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
# Poziom wysiłku modelu: low, medium, high, xhigh, max. Domyślnie `medium`, bo
# na tym poziomie policzony jest model kosztowy — `high` podniósłby rachunek
# ponad to, co zaplanowane.
AI_EFFORT=medium
# Wysiłek FAZY ROZMOWY, gdy działa routing (AI_MODEL_TOOLS). Domyślnie `low`,
# co na Haiku 4.5 znaczy BEZ myślenia — myślenie jest tam największą pozycją
# rachunku, a przepisywanie danych z narzędzi go nie potrzebuje.
AI_EFFORT_TOOLS=low
# Twardy limit jednej tury; po nim tura = FAILED z errorCode AI_TIMEOUT.
# 240000 (4 min) — przy 90000 trudniejsze pytania padały w połowie pracy.
# Zaworem kosztowym jest AI_MAX_TURN_COST_USD, nie ten czas.
AI_TURN_TIMEOUT_MS=240000
# Kwoty miesięczne per GOSPODARSTWO (licznik AiUsageCounter, okres UTC).
# Wiadomość liczy się na starcie tury i wraca przy porażce; plan liczy się przy
# ZAPISIE tygodnia — dry-run, odmowa i zapis bez zmian nie kosztują nic.
# W trybie propozycji (AI_CARDS_MODE) plan schodzi dopiero przy kliknięciu
# „Dodaj do planu", nie w turze.
#
# TO NIE JEST CENNIK. Kto zapłacił, dostaje limity KUPIONEGO produktu
# (src/config/subscription-products.ts: Solo 30/8, We dwoje 50/12,
# Rodzina 75/18). Te dwie liczby dostaje wyłącznie ten, kto produktu nie ma:
# AI_TIER_OVERRIDE=PRO, nadanie operatora i nieznany SKU. Do 7.09.2026 stało
# tu 200/30, co zmierzony benchmark wycenił na $20,34/mies. — blisko czterech
# najdroższych subskrypcji na jedno takie gospodarstwo. Domyślne (puste)
# = tyle, co Solo.
AI_LIMIT_MESSAGES_PER_MONTH=30
AI_LIMIT_PLANS_PER_MONTH=8
# Plan gospodarstwa. Brak zmiennej = PRO dla wszystkich (jak dotąd — do czasu
# subskrypcji w App Store). Puste / off = model próbny: bez subskrypcji ani
# nadania operatora (`POST /ops/households/:id/tier`) gospodarstwo ma
# jednorazową pulę AI_TRIAL_MESSAGES wiadomości i AI_TRIAL_PLANS zapisów.
# Sufit kosztu JEDNEGO gospodarstwa na miesiąc (USD); `off` = bez sufitu.
# Limit wiadomości nie jest sufitem kosztu: tura przerwana timeoutem oddaje
# wiadomość do puli, ale pieniądze u dostawcy już poszły. Bez tego jeden dom
# w pętli błędów wyczerpuje budżet dobowy CAŁEJ instalacji.
# 14, bo najdroższy legalny miesiąc (Rodzina, pełne 75 wiadomości) to
# zmierzone $7,63 na ciepłym cache i ~$10,70 na zimnym. Niżej ucinałoby
# uczciwe użycie; wcześniejsze 18 przepuszczało trzykrotność przychodu.
AI_HOUSEHOLD_MONTHLY_COST_USD=14

# Sufit kosztu JEDNEGO gospodarstwa na DOBĘ (USD) albo `off`.
# MUSI być niższy niż AI_GLOBAL_DAILY_BUDGET_USD — inaczej jeden dom
# wyczerpuje dobę całej instalacji i wyłącza asystenta wszystkim, nie
# zbliżywszy się do własnego sufitu miesięcznego. Brak zmiennej = 1.5.
AI_HOUSEHOLD_DAILY_COST_USD=1.5
# `PRO` = asystent za darmo dla wszystkich (tryb sprzed sprzedaży). Cokolwiek
# innego — także BRAK tej zmiennej — znaczy „plan liczy się z subskrypcji".
# UWAGA: do 4.09.2026 brak zmiennej znaczył `PRO`, więc jej SKASOWANIE w
# Railway (czyli to, co człowiek robi, chcąc ją wyczyścić) rozdawało asystenta
# za darmo i wyłączało całą ścieżkę płatności — bez śladu w logu.
AI_TIER_OVERRIDE=PRO
AI_TRIAL_MESSAGES=5
AI_TRIAL_PLANS=1
# Ile tur asystenta naraz w jednym gospodarstwie (wszystkie rozmowy razem);
# 0 = bez limitu. Lease per rozmowa nie chronił budżetu dobowego przed
# burstem w wielu rozmowach.
AI_MAX_CONCURRENT_TURNS_PER_HOUSEHOLD=2
# Kto może rozmawiać z asystentem: identyfikatory użytkowników albo e-maile,
# po przecinku (wielkość liter bez znaczenia). PUSTE = wszyscy zalogowani.
# Aplikacja jest w App Store — do czasu zgód, polityki i paywalla to jedyna
# bramka między „rodzina testuje" a „obcy palą klucz". Konto spoza listy
# dostaje 503 AI_DISABLED (telefon pokazuje „asystent niedostępny").
# Bramka stoi tylko na założeniu rozmowy i wysłaniu wiadomości; odczyt i
# kasowanie własnych rozmów zostają otwarte.
AI_ALLOWED_USERS=
# Bramka zgód (RODO art. 9: alergie i dieta to dane o zdrowiu). `true` =
# tura wymaga ważnej zgody AI_ASSISTANT tej osoby (POST /me/consents), a do
# modelu idą dane tylko domowników z własną zgodą; reszty pilnuje kod przy
# zapisie. Brak zgody = 403 AI_CONSENT_REQUIRED. Domyślnie WŁĄCZONE (od
# audytu 2, 3.09.2026) — `false` tylko świadomie i tylko na czas, gdy wydany
# iOS nie ma jeszcze ekranu zgody. Wersje dokumentów: src/common/legal-documents.ts.
AI_CONSENT_REQUIRED=true
# Retencja rozmów asystenta: po tylu dniach od ostatniej wiadomości rozmowa
# (z turami, kartami i propozycjami) znika automatycznie — tyle obiecuje
# polityka prywatności. `0` = bez retencji. Księga kosztów (AiUsage) zostaje.
AI_CONVERSATION_RETENTION_DAYS=90
# Sufit kosztu JEDNEJ tury (USD). Po odchudzeniu get_week_plan (7.09.2026)
# najdroższa ZMIERZONA uczciwa tura to $0,594 (podmiana dla jednej osoby,
# 6 rund), a p95 z 45 przebiegów to $0,32. 0.8 zostawia zapas na zimny cache
# i tnie ucieczkę na 12 rundach. Po przekroczeniu model dostaje prośbę
# o odpowiedź bez narzędzi. `off` = bez sufitu.
AI_MAX_TURN_COST_USD=0.8
# Karty i propozycje. `off` = jak dotąd: model sam zapisuje plan w trakcie tury
# (dźwignia awaryjna). `soft` = tryb propozycji tylko dla klientów, którzy
# zadeklarowali `clientCapabilities: ["cards.v1"]` — stary build dostaje stare
# zachowanie, bo karty i tak by nie pokazał. `strict` = propozycje dla
# wszystkich, po adopcji buildu iOS.
# UWAGA: `off` przy AI_ENABLED=true to ODMOWA STARTU na produkcji — w tym
# trybie model zapisuje plan sam, bez karty, bez potwierdzenia i bez
# „Cofnij". Brak zmiennej i literówka znaczą `strict` (fail-safe).
AI_CARDS_MODE=soft
# Jak długo propozycja daje się zatwierdzić i ile jest czasu na „Cofnij".
AI_PROPOSAL_TTL_MS=259200000
AI_PROPOSAL_UNDO_WINDOW_MS=3600000
# Bezpiecznik na rachunek: dobowy koszt całej instalacji w USD. Puste = wartość
# domyślna ($5/dobę, ok. 30 tur), `off` = BEZ LIMITU (świadoma decyzja), `0` =
# zatrzymaj wszystko. Po przekroczeniu /agent oddaje 503 AI_BUDGET_PAUSED.
AI_GLOBAL_DAILY_BUDGET_USD=
# Opóźnienie dostawcy `stub` (testy lease i timeoutu).
AI_STUB_DELAY_MS=0

# Recipe image generation (optional)
IMAGE_GENERATOR_PROVIDER=pollinations
IMAGE_GENERATOR_BASE_URL=https://image.pollinations.ai/prompt
IMAGE_GENERATOR_QUERY=width=1200&height=800&nologo=true
IMAGE_GENERATOR_STYLE=ultra realistic food photography, natural light, 50mm lens, shallow depth of field
IMAGE_GENERATOR_SEED_PREFIX=scoffie
IMAGE_HOUSEHOLD_NAME=Home
IMAGE_RECIPE_LIMIT=0
IMAGE_OVERWRITE_EXISTING=false

# Cloudflare R2 image storage (optional)
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
# Poprzednie buckety (po przecinku): ich adresy w bazie dalej są „prawdziwym"
# zdjęciem, a nie starym plikiem do podmiany na generator.
R2_LEGACY_PUBLIC_BASE_URLS=
R2_KEY_PREFIX=recipe-images
R2_OVERWRITE_EXISTING=false
R2_SYNC_OVERWRITE_EXISTING=false
R2_SYNC_EXTENSIONS=webp,png,jpg,jpeg

# APNs push notifications (optional)
APNS_ENABLED=false
APNS_USE_SANDBOX=true
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=

# Zbieranie powiadomień push (wartości w milisekundach).
#
# Powiadomienia nie wychodzą per zdarzenie, tylko po tym, jak autor zmian
# przestanie klikać: `QUIET` to cisza po ostatniej zmianie, po której paczka
# wychodzi, `MAX` to sufit dla kogoś, kto klika bez przerwy. Puste = domyślne
# z kodu (plan 60 s / 5 min, lista zakupów 3 min / 15 min).
PUSH_BATCH_QUIET_MS=
PUSH_BATCH_MAX_MS=
PUSH_SHOPPING_BATCH_QUIET_MS=
PUSH_SHOPPING_BATCH_MAX_MS=

# Alert dla operatora (Discord/Slack/ntfy — dowolny webhook przyjmujący POST
# z JSON-em {content, text}). Puste = wyłączone. Dziś wysyłane: wyczerpany
# budżet dobowy asystenta (raz na dobę) i otwarcie bezpiecznika dostawcy
# (raz na 6 h). Bez treści rozmów i danych osobowych.
OPS_ALERT_WEBHOOK_URL=

# Sentry (błędy serwera z kontekstem). Puste = wyłączone; z DSN idą tylko
# błędy 5xx i wyjątki spoza kontraktu — bez nagłówków, ciała żądania, treści
# wiadomości i danych profilu (src/instrument.ts). Projekt w regionie EU.
SENTRY_DSN=
# Próbkowanie wydajności (0–1); 0 = tylko błędy.
SENTRY_TRACES_SAMPLE_RATE=0
# Profile CPU (0–1, losowane raz na proces); działa tylko przy śladach > 0.
SENTRY_PROFILE_SESSION_SAMPLE_RATE=0
# true = logi warn/error także do Sentry Logs (bez IP, UA, query i e-maili).
SENTRY_LOGS=false

# Commit, z którego zbudowano obraz — wystawiany na GET /ops/health.
# Na Railwayu wystarczy RAILWAY_GIT_COMMIT_SHA, które platforma ustawia sama.
APP_COMMIT=

# Recipes list cache
RECIPES_LIST_CACHE_ENABLED=true
RECIPES_LIST_CACHE_TTL_SECONDS=90

# Recipe ownership auto-recovery
AUTO_RECOVER_MISSING_USER=false
# Gospodarstwo katalogu po ID (to samo, co RECIPE_IMPORT_HOUSEHOLD_ID)
AUTO_RECOVER_HOUSEHOLD_ID=22222222-2222-4222-8222-222222222222

# Safe-migrate startup hooks
# Zasiew katalogu składników i przepisów. Chodzi tylko na PUSTEJ bazie (albo po
# rebuildzie) — baza z danymi nigdy nie jest ruszana, bo import domyślnie
# czyści katalog. `false` wyłącza zasiew także na świeżej bazie.
SAFE_MIGRATE_BOOTSTRAP_RECIPES=true
# Jednorazowe wgranie tagów składników (alergeny/diety) po migracji: biegnie
# tylko wtedy, gdy katalog składników istnieje, a ŻADEN składnik nie ma tagów
# (kolumny nigdy nie zasilone). Baza z tagami nie jest ruszana — korekty pliku
# `ingredient-tags-pl-v1.json` wgrywa się ręcznie: `pnpm catalog:ingredients:tags`.
SAFE_MIGRATE_LOAD_INGREDIENT_TAGS=true
# Opt-in: backfill adresów obrazków z R2 przy starcie (jednorazowo lepiej
# przez `pnpm exec tsx scripts/backfill-recipe-image-urls-from-r2.ts`).
SAFE_MIGRATE_BACKFILL_R2_IMAGE_URLS=false
# DESTRUKCYJNE: DROP SCHEMA public. CONFIRM = dzisiejsza data UTC (YYYY-MM-DD),
# samowygasające; na produkcji dodatkowo SAFE_MIGRATE_ALLOW_PROD_REBUILD musi
# równać się hostowi z DATABASE_URL (np. example.proxy.rlwy.net:12345).
SAFE_MIGRATE_REBUILD_DB=false
SAFE_MIGRATE_REBUILD_CONFIRM=
SAFE_MIGRATE_ALLOW_PROD_REBUILD=

# JSON recipes import (manual/local)
# WYMAGANE przy imporcie — brak domyślnego pliku, żeby nikt nie wgrał testowej partii przez pomyłkę
RECIPE_IMPORT_FILE=prisma/catalog/recipes-catalog-full-v2.json
RECIPE_IMPORT_CLEAR_EXISTING=false
RECIPE_IMPORT_BUILD_R2_IMAGE_URLS=true
RECIPE_IMPORT_IMAGE_EXTENSION=webp
RECIPE_IMPORT_OWNER_USER_ID=11111111-1111-4111-8111-111111111111
RECIPE_IMPORT_OWNER_LEGACY_SUB=legacy-recipe-import-owner
RECIPE_IMPORT_OWNER_DISPLAY_NAME=Recipe Import Bot
RECIPE_IMPORT_OWNER_EMAIL=recipe-import-bot@example.com
# Gospodarstwo katalogu po ID. Na istniejącej bazie (dev/prod) wpisz ID gospodarstwa,
# które już trzyma katalog: SELECT "householdId", count(*) FROM "Recipe" WHERE "authorId" = '<RECIPE_IMPORT_OWNER_USER_ID>' GROUP BY 1;
# Na świeżej bazie importer utworzy gospodarstwo o tym ID.
RECIPE_IMPORT_HOUSEHOLD_ID=22222222-2222-4222-8222-222222222222

# Optional local smoke-script overrides
WS_URL=http://localhost:3000
WS_TIMEOUT_MS=5000
# Token do `pnpm ws:smoke` (albo flaga --dev-login <nazwa>, która pobiera go
# z POST /auth/dev — tylko przy AUTH_DEV_LOGIN_ENABLED=true).
WS_TOKEN=

# --- Integracja Cookidoo (Thermomix) ---
# URL mikroserwisu scoffie-cookidoo. Dla api odpalanego z hosta:
# localhost:8000; w docker-compose nadpisywane inline na http://cookidoo:8000;
# na Railway: http://<nazwa-serwisu>.railway.internal:8000 (private networking).
COOKIDOO_SERVICE_URL=http://localhost:8000
# Wspólny sekret Nest <-> Python (INTERNAL_TOKEN po stronie mikroserwisu).
# Generowanie: openssl rand -base64 32
COOKIDOO_SERVICE_TOKEN=
# Klucz AES-256-GCM do poświadczeń Cookidoo w bazie (32 bajty w base64).
# Generowanie: openssl rand -base64 32. Utrata klucza = użytkownicy łączą
# konto ponownie (stare wpisy stają się nieczytelne — status zwróci
# connected:false).
COOKIDOO_ENCRYPTION_KEY=
# Timeout wywołań do mikroserwisu (ms); login do Cookidoo potrafi chwilę trwać.
COOKIDOO_SERVICE_TIMEOUT_MS=15000
# Przełącznik integracji: brak zmiennej = włączona; wyłącza WYŁĄCZNIE `false`.
# Po wyłączeniu status oddaje `enabled: false` (klient chowa wiersz),
# connect i send-to-week odpowiadają 503 COOKIDOO_DISABLED, a disconnect
# nadal działa. Decyzja 2.09.2026: schowana do czasu ~30 przepisów TM
# i zapisów w regulaminie (użytkownik oddaje hasło do usługi trzeciej).
COOKIDOO_INTEGRATION_ENABLED=true

# --- Sign in with Apple ---
# Identyfikator pakietu iOS (audience tokenu tożsamości). APPLE_CLIENT_ID to alias.
APPLE_AUDIENCE=
APPLE_CLIENT_ID=
# Klucz „Sign in with Apple" do unieważniania tokenów przy usunięciu konta
# (App Store 5.1.1(v)). Bez tych trzech usunięcie konta nie odwołuje sesji
# u Apple. Klucz .p8 wklejony z zachowaniem znaków nowej linii (\n).
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Płatności App Store (subskrypcje PRO) ---
# Pieprz do haszowania tożsamości zakupowej. TEGO SEKRETU NIE WOLNO ROTOWAĆ:
# na haszu wiszą pula próbna i przypisanie subskrypcji do osoby, więc zmiana
# daje wszystkim świeżą próbę i odpina każdą opłaconą subskrypcję.
PURCHASE_IDENTITY_PEPPER=
# Główny wyłącznik zakupów. `false` (domyślnie) = paywall pokazuje ofertę i nie
# pobiera pieniędzy; `/billing/apple/transaction` odpowiada 503.
# Włączenie działa dopiero z kompletem trzech zmiennych niżej.
BILLING_ENABLED=false
# Identyfikator pakietu iOS — transakcja z innej aplikacji jest odrzucana.
APPLE_BUNDLE_ID=app.scoffie.ios
# Numeryczne `appAppleId` z App Store Connect; 0 = nie sprawdzamy.
APPLE_APP_APPLE_ID=0
# Klucz App Store Server API (App Store Connect → Integrations → Keys).
# TO INNY KLUCZ NIŻ `APPLE_PRIVATE_KEY`/`APPLE_KEY_ID` wyżej, które służą do
# „Zaloguj się przez Apple". Pomylenie ich daje 401 przy każdej weryfikacji.
APPLE_ISSUER_ID=
APPLE_BILLING_KEY_ID=
APPLE_BILLING_PRIVATE_KEY=
# `Production` albo `Sandbox`. Na produkcji MUSI być `Production`, inaczej
# prawdziwe zakupy z App Store są odrzucane.
APPLE_ENVIRONMENT=Sandbox
# Czy uznawać transakcje z sandboxa. Domyślnie tak poza produkcją, nie na
# produkcji — `true` na produkcji daje darmowe PRO każdemu z TestFlightem.
APPLE_ACCEPT_SANDBOX=
# Po ilu godzinach bez potwierdzenia od Apple odświeżyć subskrypcję
# (siatka bezpieczeństwa pod zgubione powiadomienia).
APPLE_RECONCILE_AFTER_HOURS=24
# Limit czasu na odpowiedź App Store Server API.
APPLE_SERVER_API_TIMEOUT_MS=8000
# Adres App Store Server API — puste = dobierany z APPLE_ENVIRONMENT.
APPLE_SERVER_API_URL=
# Odcisk przypiętego korzenia Apple; puste = Apple Root CA - G3 z kodu.
APPLE_ROOT_CA_SHA256=
# Czy przyjmować subskrypcje udostępnione przez Chmurę Rodzinną. Domyślnie NIE:
# każdy członek rodziny dostaje własną transakcję z własnym
# `originalTransactionId`, czyli własny wiersz i własną PEŁNĄ pulę wiadomości —
# jedna opłata 29,99 zł potrafi utrzymać sześć pul.
APPLE_ACCEPT_FAMILY_SHARED=false
# Korzeń łańcucha certyfikatów w postaci PEM. IGNOROWANY NA PRODUKCJI (tam
# zawsze obowiązuje korzeń Apple wpisany w kodzie). Służy wyłącznie testom na
# żywej bazie, które podpisują transakcje własnym łańcuchem.
APPLE_ROOT_CA_PEM=

# --- Skrypty narzędziowe (pnpm ... ; nie czytane przez serwer) ---
# Seed kasuje CAŁĄ bazę: działa tylko na lokalnym DATABASE_URL i z dzisiejszą datą.
SEED_CONFIRM=
# Import katalogu: kasowanie katalogu wymaga dodatkowo dzisiejszej daty.
RECIPE_IMPORT_CLEAR_CONFIRM=
# Import katalogu: nazwa domu katalogu (domyślnie „Katalog Scoffie").
RECIPE_IMPORT_HOUSEHOLD_NAME=
# Import katalogu: pozwól zmienić tytuł istniejącego przepisu (domyślnie nie).
RECIPE_IMPORT_ALLOW_RETITLE=false
# Ładowarki składników — pliki źródłowe (domyślne ścieżki w skryptach).
INGREDIENT_NUTRITION_FILE=
INGREDIENT_TAGS_FILE=
IMAGE_URL_SOURCE_FILE=
# Bezpieczna migracja: jednorazowe przepisanie adresów obrazków na R2 przy starcie.
SAFE_MIGRATE_BACKFILL_R2_IMAGE_URLS=false

ANTHROPIC_API_KEY=

# ─────────────────────────── POCZTA TRANSAKCYJNA ───────────────────────────
# Siedem wiadomości o koncie (powitanie, dołączenie do domu, wyczerpana pula
# asystenta, płatność, wygaśnięcie, usunięcie konta, zmiana dokumentów).
# Szczegóły i runbook: docs/POWIADOMIENIA-MAILOWE.md

# Główny wyłącznik. `false` NIE oznacza „kolejkuj i nie wysyłaj": nic nie
# trafia do skrzynki nadawczej. Dzięki temu włączenie poczty na produkcji nie
# wypycha naraz kilku tygodni zaległych powitań do ludzi, dla których ta treść
# jest już nieprawdziwa.
MAIL_ENABLED=false

# stub = zapis maila na dysk (MAIL_STUB_DIR), nic nie wychodzi na świat.
# resend = prawdziwa wysyłka.
MAIL_TRANSPORT=stub

# Klucz z panelu Resendu. Wymagany tylko przy MAIL_TRANSPORT=resend.
RESEND_API_KEY=

# Nadawca i adres do odpowiedzi. Domena musi być zweryfikowana u dostawcy
# ORAZ zarejestrowana w Apple Developer (Sign in with Apple for Email
# Communication) — bez tego maile na aliasy @privaterelay.appleid.com odbijają
# się wszystkie naraz.
MAIL_FROM=Scoffie <support@scoffie.app>
MAIL_REPLY_TO=support@scoffie.app

# BEZPIECZNIK. Niepuste = KAŻDY mail leci pod ten adres, a prawdziwy odbiorca
# ląduje w temacie i w nagłówku X-Scoffie-Original-To. Do prób z prawdziwym
# dostawcą. Na produkcji ustawiona wartość WYWRACA START — to pomyłka
# konfiguracji, nie funkcja.
MAIL_REDIRECT_TO=

# Skąd mail bierze znak w nagłówku i dokąd prowadzą linki w treści. Osobno.
# Obrazek DOMYŚLNIE z backendu (public/email/ pod /static/), NIE ze strony:
# plik jedzie w jednym deployu z kodem, a 404 Nesta nie niesie Cache-Control.
# Strona raz oddała 404 sprzed deployu z max-age na dobę i Apple Mail przez
# dobę pokazywał pustą ramkę zamiast znaku. Puste = domyślne.
MAIL_ASSET_BASE_URL=
MAIL_SITE_URL=https://scoffie.app

# Sekret webhooka odrzutów i skarg (whsec_… z panelu Resendu). Bez niego nie da
# się przyjąć odbić, a wysyłka na martwe adresy psuje reputację domeny.
MAIL_WEBHOOK_SECRET=

# Pętla wysyłkowa. Puste = wartości domyślne (15 s, 5 prób, 20 na przebieg).
MAIL_WORKER_INTERVAL_MS=
MAIL_MAX_ATTEMPTS=
MAIL_BATCH_SIZE=
MAIL_STUB_DIR=
