DATABASE_URL=postgresql://weeklymeals:weeklymeals@localhost:5432/weeklymeals?schema=public
JWT_SECRET=replace-me
JWT_EXPIRES_IN=30d
REFRESH_TOKEN_DAYS=30
REFRESH_TOKEN_PEPPER=replace-me
WS_CORS_ORIGIN=*

# Recipe import source
RECIPES_API_PROVIDER=recipe-api
RECIPES_API_KEY=
RECIPES_API_BASE_URL=https://recipe-api.com
RECIPES_API_RECIPES_PATH=/api/v1/recipes
RECIPES_API_DETAILS_PATH_TEMPLATE=/api/v1/recipes/:id
RECIPES_IMPORT_COUNT=5
RECIPES_API_AUTH_MODE=header
RECIPES_API_KEY_HEADER=X-API-Key
RECIPES_API_KEY_QUERY_PARAM=apiKey
RECIPES_IMAGE_FALLBACK_ENABLED=false
RECIPES_IMAGE_FALLBACK_TEMPLATE=https://placehold.co/1200x800/F3F4F6/111827?text=:title

# Translator (optional)
TRANSLATOR_API_KEY=
TRANSLATOR_API_BASE_URL=
TRANSLATOR_AUTH_HEADER=
TRANSLATOR_MAX_RETRIES=4
TRANSLATOR_BASE_DELAY_MS=8000
TRANSLATOR_MIN_INTERVAL_MS=1200
TRANSLATOR_FAIL_OPEN=true
TRANSLATE_HOUSEHOLD_NAME=Home
TRANSLATE_RECIPE_LIMIT=0
TRANSLATE_SOURCE_LANG=EN
TRANSLATE_TARGET_LANG=PL

# Image generation (URL-based)
IMAGE_GENERATOR_PROVIDER=pollinations
IMAGE_GENERATOR_BASE_URL=https://image.pollinations.ai/prompt
IMAGE_GENERATOR_QUERY=width=1200&height=800&nologo=true
IMAGE_GENERATOR_STYLE=ultra realistic food photography, natural light, 50mm lens, shallow depth of field
IMAGE_GENERATOR_SEED_PREFIX=weekly-meals
IMAGE_HOUSEHOLD_NAME=Home
IMAGE_RECIPE_LIMIT=0
IMAGE_OVERWRITE_EXISTING=false

# S3 image storage (AWS S3 / S3-compatible, optional)
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
S3_KEY_PREFIX=recipe-images
S3_OVERWRITE_EXISTING=false

# Import ownership/context
IMPORT_CLEAR_EXISTING=false
IMPORT_TRANSLATE_ON_INGEST=false
IMPORT_OWNER_USER_ID=11111111-1111-4111-8111-111111111111
IMPORT_OWNER_LEGACY_SUB=legacy-import-owner
IMPORT_OWNER_DISPLAY_NAME=Import Bot
IMPORT_OWNER_EMAIL=import-bot@example.com
IMPORT_HOUSEHOLD_NAME=Home
AUTO_RECOVER_MISSING_USER=false
AUTO_RECOVER_HOUSEHOLD_NAME=Home

# Recipes list cache (backend)
RECIPES_LIST_CACHE_ENABLED=true
RECIPES_LIST_CACHE_TTL_SECONDS=90
