{
  "name": "weekly-meals-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node scripts/prisma-migrate-deploy-safe.js && node dist/main",
    "ws:smoke": "tsx scripts/ws-smoke.ts",
    "catalog:ingredients:load": "node scripts/prisma-migrate-deploy-safe.js && tsx scripts/load-ingredient-catalog.ts",
    "catalog:ingredients:normalize:pl": "node scripts/prisma-migrate-deploy-safe.js && tsx scripts/normalize-ingredients-polish.ts",
    "catalog:ingredients:nutrition": "tsx scripts/load-ingredient-nutrition.ts",
    "catalog:ingredients:tags": "tsx scripts/load-ingredient-tags.ts",
    "audit:recipes:nutrition": "tsx scripts/audit-recipe-nutrition.ts",
    "recipes:recompute:nutrition": "tsx scripts/recompute-recipe-nutrition.ts",
    "recipes:backfill:slots": "tsx scripts/backfill-suitable-meal-types.ts",
    "plans:backfill:servings": "tsx scripts/backfill-plan-item-servings.ts",
    "households:cleanup:empty": "tsx scripts/cleanup-empty-households.ts",
    "rodo:export": "tsx scripts/export-user-data.ts",
    "accounts:delete": "tsx scripts/delete-user-account.ts",
    "accounts:reset": "tsx scripts/reset-accounts.ts",
    "agent:scenarios": "ts-node -r tsconfig-paths/register scripts/agent-scenarios.ts",
    "agent:smoke": "ts-node -r tsconfig-paths/register scripts/agent-smoke.ts",
    "agent:measure:tokens": "tsx scripts/measure-agent-tokens.ts",
    "recipes:import:json": "node scripts/prisma-migrate-deploy-safe.js && tsx scripts/import-recipes-from-json.ts",
    "generate:recipe:images": "node scripts/prisma-migrate-deploy-safe.js && tsx scripts/generate-recipe-images.ts",
    "upload:recipe:images:r2": "node scripts/prisma-migrate-deploy-safe.js && tsx scripts/upload-recipe-images-to-r2.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "node scripts/prisma-migrate-deploy-safe.js",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "lint": "eslint \"{src,apps,libs,test,scripts,prisma}/**/*.{ts,js}\" jest.config.js prisma.config.ts --fix",
    "lint:check": "eslint \"{src,apps,libs,test,scripts,prisma}/**/*.{ts,js}\" jest.config.js prisma.config.ts",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:ci": "jest --config ./test/jest-e2e.json --runInBand",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@aws-sdk/client-s3": "^3.896.0",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/platform-socket.io": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.2.3",
    "@prisma/client": "^6.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jose": "^5.9.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.4.2",
    "prisma": "^6.2.1",
    "socket.io-client": "^4.8.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "@isaacs/brace-expansion": ">=5.0.1",
      "qs": ">=6.16.0",
      "minimatch@<4": ">=3.1.4",
      "minimatch@9": ">=9.0.7",
      "fast-xml-parser": ">=5.7.0",
      "multer": ">=2.2.0",
      "serialize-javascript": ">=7.0.5",
      "ajv@6": ">=6.14.0",
      "file-type": ">=21.3.2",
      "flatted": ">=3.4.2",
      "socket.io-parser": ">=4.2.7",
      "effect": ">=3.20.0",
      "handlebars": ">=4.7.9",
      "brace-expansion@1": ">=1.1.18",
      "brace-expansion@2": ">=2.1.4",
      "picomatch@2": ">=2.3.2",
      "path-to-regexp": ">=8.4.0",
      "lodash": ">=4.18.0",
      "defu": ">=6.1.5",
      "ws": ">=8.21.0",
      "form-data": ">=4.0.6",
      "js-yaml@3": ">=3.15.1",
      "@babel/core": ">=7.29.6",
      "engine.io": ">=6.6.7",
      "body-parser": ">=2.3.0",
      "fast-uri": ">=3.1.6",
      "deepmerge-ts": ">=8.0.0",
      "browserslist": ">=4.28.7",
      "@humanfs/node": ">=0.16.8",
      "minimatch@>=10.0.0 <11": ">=10.2.3",
      "ajv@>=8.0.0 <9": ">=8.18.0",
      "picomatch@>=4.0.0 <5": ">=4.0.4",
      "js-yaml@>=4.0.0 <5": ">=4.3.1"
    }
  }
}
